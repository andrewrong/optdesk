  "glossary": [
    {
      "term": "pass",
      "text": "正常：所有检查通过。"
    },
    {
      "term": "warn",
      "text": "警告：有检查越过了提醒线，但还没到失败。"
    },
    {
      "term": "fail",
      "text": "失败：至少一项检查越过了失败线，请到「采集记录」页修复。"
    },
    {
      "term": "unknown",
      "text": "未知：没有可用的事实来判定，或者存放它的数据视图读取失败。"
    },
    {
      "term": "session",
      "text": "交易日：交易所开市的一天。年龄里的 s 就是交易日数。"
    },
    {
      "term": "ledger",
      "text": "台账：运行器记录的每个交易日应当采集的键和已经存下的键。"
    },
    {
      "term": "trial",
      "text": "试用值：我们自己定的阈值，读到真实数据后再调整；def 表示定义上就不能违反。"
    },
    {
      "term": "share",
      "text": "占比：出问题的行数除以检查的行数。"
    },
    {
      "term": "split",
      "text": "拆股：一股拆成几股，价格会一次性大幅下跌，看起来像是数据跳变。"
    },
    {
      "term": "crossed",
      "text": "买卖倒挂：买价高于卖价。"
    },
    {
      "term": "non_live",
      "text": "非实时：行情是冻结或延迟的，不是当时的实时报价。"
    },
    {
      "term": "coverage",
      "text": "覆盖：计划采集的键里实际存下了多少。"
    }
  ],
