{
  "$defs": {
    "IntradayCarried": {
      "additionalProperties": false,
      "description": "A daily vote the 盘中试算 carries from the close, with the close date it was made on.",
      "properties": {
        "close_date": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$",
          "title": "Close Date",
          "type": "string"
        },
        "label": {
          "const": "收盘",
          "title": "Label",
          "type": "string"
        },
        "vote": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Vote",
          "type": "string"
        }
      },
      "required": [
        "vote",
        "close_date",
        "label"
      ],
      "title": "IntradayCarried",
      "type": "object"
    },
    "IntradayGaugeBlock": {
      "additionalProperties": false,
      "description": "The 盘中试算 itself: made only when both live legs counted.",
      "properties": {
        "carried": {
          "items": {
            "$ref": "#/$defs/IntradayCarried"
          },
          "maxItems": 2,
          "title": "Carried",
          "type": "array"
        },
        "headline": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "label": {
          "const": "盘中试算",
          "title": "Label",
          "type": "string"
        },
        "ratio_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Ratio Text",
          "type": "string"
        },
        "state": {
          "enum": [
            "good",
            "mixed",
            "bad",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "headline",
        "ratio_text",
        "label",
        "carried"
      ],
      "title": "IntradayGaugeBlock",
      "type": "object"
    },
    "IntradayRow": {
      "additionalProperties": false,
      "description": "One live figure of the 盘中试算 (issue #1224): VIX or VIX3M with the time the exchange gave\nit, its data type and its label. ``stale`` is a label naming the age of a quote too old to\ncount; the browser only compares its clock with ``stale_after``.\n\nThe SPX row (issue #1225) is the live index point feeding the trend vote: ``source_time`` is the\nexchange's time with its zone, ``baseline_through`` the session ending the 200-close mean and\n``detail`` the ratio against that mean with the verdict, written by Python.",
      "properties": {
        "as_of": {
          "maxLength": 200,
          "minLength": 1,
          "title": "As Of",
          "type": "string"
        },
        "baseline_through": {
          "anyOf": [
            {
              "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Through"
        },
        "data_type": {
          "enum": [
            "live",
            "delayed"
          ],
          "title": "Data Type",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "label": {
          "enum": [
            "盘中",
            "盘中·延迟"
          ],
          "title": "Label",
          "type": "string"
        },
        "series": {
          "enum": [
            "VIX",
            "VIX3M",
            "SPX"
          ],
          "title": "Series",
          "type": "string"
        },
        "source_time": {
          "anyOf": [
            {
              "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
              "type": "string",
              "x-timezone": "owner"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Time"
        },
        "stale": {
          "anyOf": [
            {
              "$ref": "#/$defs/StaleLabel"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "series",
        "value",
        "as_of",
        "data_type",
        "label",
        "stale"
      ],
      "title": "IntradayRow",
      "type": "object"
    },
    "IntradaySection": {
      "additionalProperties": false,
      "description": "The 盘中 section beside the close gauge (issue #1224). ``gauge`` is None when no gauge could\nbe made; ``rows`` then show what is valid or stale, and ``status_line`` says why (it carries no\ndeadline). ``as_of`` is the time of the newest counted live quote and never implies the carried\ndaily votes were refreshed. The browser hides the section from ``expires_at`` on (the one\ncomparison it makes) and shows ``expired_text`` in its place.",
      "properties": {
        "as_of": {
          "maxLength": 200,
          "minLength": 1,
          "title": "As Of",
          "type": "string"
        },
        "expired_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Expired Text",
          "type": "string"
        },
        "expires_at": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Expires At",
          "type": "string",
          "x-timezone": "owner"
        },
        "footnote": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Footnote",
          "type": "string"
        },
        "gauge": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntradayGaugeBlock"
            },
            {
              "type": "null"
            }
          ]
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/IntradayRow"
          },
          "maxItems": 3,
          "title": "Rows",
          "type": "array"
        },
        "status": {
          "enum": [
            "ok",
            "stale",
            "busy",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "status_line": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Line"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trend_line": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trend Line"
        }
      },
      "required": [
        "title",
        "status",
        "status_line",
        "as_of",
        "expires_at",
        "rows",
        "gauge",
        "footnote",
        "expired_text"
      ],
      "title": "IntradaySection",
      "type": "object"
    },
    "MismatchFigure": {
      "additionalProperties": false,
      "description": "A level of one source, or the absolute difference of the two, in the units of the series.",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "index_points",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Value",
          "type": "number",
          "x-decimals": 2,
          "x-rounding": "ROUND_HALF_UP"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "MismatchFigure",
      "type": "object"
    },
    "MismatchLine": {
      "additionalProperties": false,
      "description": "A day on which IBKR and FRED differ: by more than the tolerance, or enough to put the two\nvalues on different sides of a band. ``diff`` is the absolute difference.",
      "properties": {
        "day": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$",
          "title": "Day",
          "type": "string"
        },
        "diff": {
          "$ref": "#/$defs/MismatchFigure"
        },
        "fred": {
          "$ref": "#/$defs/MismatchFigure"
        },
        "ibkr": {
          "$ref": "#/$defs/MismatchFigure"
        },
        "kind": {
          "enum": [
            "beyond_tolerance",
            "band_flip"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "day",
        "ibkr",
        "fred",
        "diff",
        "kind"
      ],
      "title": "MismatchLine",
      "type": "object"
    },
    "StaleLabel": {
      "additionalProperties": false,
      "description": "Python sends the times and the label; the browser only compares its clock with ``stale_after``.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "stale_after": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Stale After",
          "type": "string",
          "x-timezone": "owner"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "data_time",
        "stale_after",
        "text"
      ],
      "title": "StaleLabel",
      "type": "object"
    },
    "VoteRow": {
      "additionalProperties": false,
      "description": "One vote: its verdict, the figure it rests on (text written by Python), where the figure is\nfrom and its date. ``first_ibkr_date`` is the first day IBKR has for the series, ``None`` when\nunknown.",
      "properties": {
        "figure_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Figure Text",
          "type": "string"
        },
        "first_ibkr_date": {
          "anyOf": [
            {
              "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Ibkr Date"
        },
        "kind": {
          "enum": [
            "volatility",
            "trend",
            "credit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "observed": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$",
          "title": "Observed",
          "type": "string"
        },
        "source": {
          "enum": [
            "IBKR",
            "FRED"
          ],
          "title": "Source",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "bad",
            "ok",
            "unknown"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "verdict",
        "figure_text",
        "source",
        "observed",
        "first_ibkr_date"
      ],
      "title": "VoteRow",
      "type": "object"
    }
  },
  "$id": "https://option-trader.invalid/schemas/market_weather.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The block; ``schema`` and ``schema_version`` are the part of the envelope it carries alone.",
  "properties": {
    "closed": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closed"
    },
    "footnote": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Footnote",
      "type": "string"
    },
    "headline": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Headline",
      "type": "string"
    },
    "intraday": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntradaySection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mismatches": {
      "items": {
        "$ref": "#/$defs/MismatchLine"
      },
      "maxItems": 60,
      "title": "Mismatches",
      "type": "array"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/VoteRow"
      },
      "maxItems": 3,
      "title": "Rows",
      "type": "array"
    },
    "schema": {
      "const": "market_weather",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stale": {
      "anyOf": [
        {
          "$ref": "#/$defs/StaleLabel"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "good",
        "mixed",
        "bad",
        "unknown"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "headline",
    "state",
    "rows",
    "footnote",
    "mismatches",
    "stale"
  ],
  "title": "MarketWeather",
  "type": "object"
}
