{
  "$defs": {
    "Compare": {
      "additionalProperties": false,
      "description": "What the roll decision needs, as ready texts (gross: no fee is deducted). ``cash_after`` is the\naccount's cash less all its puts expiring on or before this structure's expiry, not this structure\nalone. ``sentence`` is facts beside the two owner values (``captured_param``, ``exit_dte_param``),\n``None`` when both are set and neither is reached; it never tells the owner to act.",
      "properties": {
        "captured_param": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Captured Param",
          "type": "string"
        },
        "cash_after": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Cash After"
        },
        "close_cost": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Close Cost"
        },
        "exit_dte_param": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Exit Dte Param",
          "type": "string"
        },
        "recent_commission": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Recent Commission"
        },
        "roll_net": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Roll Net"
        },
        "sentence": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sentence"
        }
      },
      "required": [
        "close_cost",
        "roll_net",
        "cash_after",
        "recent_commission",
        "sentence",
        "captured_param",
        "exit_dte_param"
      ],
      "title": "Compare",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "description": "A named data gap, used in place of a figure that cannot be computed. Never a zero.",
      "properties": {
        "reason": {
          "enum": [
            "missing_quote",
            "no_data",
            "unsupported_currency",
            "not_built",
            "no_reader",
            "no_news_source",
            "no_rule",
            "market_closed",
            "stale",
            "flex_time_unknown",
            "jp_slice_missing",
            "missing_input",
            "stale_input"
          ],
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "text"
      ],
      "title": "Gap",
      "type": "object"
    },
    "SourceTime": {
      "additionalProperties": false,
      "description": "The data time of one source behind the card.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "source": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "data_time"
      ],
      "title": "SourceTime",
      "type": "object"
    },
    "StaleLabel": {
      "additionalProperties": false,
      "description": "Python sends the times and the label; the browser only compares its clock with ``stale_after``.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "stale_after": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Stale After",
          "type": "string",
          "x-timezone": "owner"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "data_time",
        "stale_after",
        "text"
      ],
      "title": "StaleLabel",
      "type": "object"
    },
    "StructureGroup": {
      "additionalProperties": false,
      "description": "One card of the page: its title and its rows in order.",
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/StructureRow"
          },
          "maxItems": 200,
          "title": "Rows",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "rows"
      ],
      "title": "StructureGroup",
      "type": "object"
    },
    "StructureRow": {
      "additionalProperties": false,
      "description": "One structure. ``symbol`` is the first cell and leads to ``href``, the detail route of its key.",
      "properties": {
        "compare": {
          "anyOf": [
            {
              "$ref": "#/$defs/Compare"
            },
            {
              "type": "null"
            }
          ]
        },
        "distance": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Distance"
        },
        "earned": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Earned"
        },
        "ex_dividend": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/Gap"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ex Dividend"
        },
        "expiry_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Expiry Text",
          "type": "string"
        },
        "href": {
          "pattern": "^/structure/[A-Za-z0-9_-]{1,64}$",
          "title": "Href",
          "type": "string"
        },
        "kind_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Kind Text",
          "type": "string"
        },
        "max_gain": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usd"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Max Gain"
        },
        "max_loss": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usd"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Max Loss"
        },
        "moneyness": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Moneyness"
        },
        "pnl": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usd"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Pnl"
        },
        "symbol": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "href",
        "kind_text",
        "expiry_text",
        "moneyness",
        "distance",
        "earned",
        "ex_dividend",
        "compare",
        "max_loss",
        "max_gain",
        "pnl"
      ],
      "title": "StructureRow",
      "type": "object"
    },
    "Usd": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "usd",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": -1000000000,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "Usd",
      "type": "object"
    }
  },
  "$id": "https://option-trader.invalid/schemas/structures_list.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Build Id",
      "type": "string"
    },
    "data_times": {
      "items": {
        "$ref": "#/$defs/SourceTime"
      },
      "maxItems": 20,
      "title": "Data Times",
      "type": "array"
    },
    "generated_at": {
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
      "title": "Generated At",
      "type": "string",
      "x-timezone": "owner"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/StructureGroup"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Groups",
      "type": "array"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "schema": {
      "const": "structures_list",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Scope",
      "type": "string"
    },
    "sentence": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Sentence",
      "type": "string"
    },
    "stale": {
      "$ref": "#/$defs/StaleLabel"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "title",
    "sentence",
    "groups",
    "stale"
  ],
  "title": "StructuresList",
  "type": "object"
}
