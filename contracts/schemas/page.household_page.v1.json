{
  "$defs": {
    "AccountFigure": {
      "additionalProperties": false,
      "description": "One cell of the account table: the figure, or None with the words for why it is missing.",
      "properties": {
        "cell": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyCell"
            },
            {
              "type": "null"
            }
          ]
        },
        "gap": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap"
        }
      },
      "required": [
        "cell"
      ],
      "title": "AccountFigure",
      "type": "object"
    },
    "AccountRow": {
      "additionalProperties": false,
      "description": "The line of a Flex-only member (issue #1588; #1572). Named by a label, never an alias;\n``stock`` may read ``至少 …`` when a name of hers is left out; ``data_day`` is her own.\n``scope`` is the key of the scope the row sits under and ``whose`` the account's whose word\n(issue #1680).",
      "properties": {
        "cash": {
          "$ref": "#/$defs/AccountFigure"
        },
        "data_day": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Day"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "net_liquidation": {
          "$ref": "#/$defs/AccountFigure"
        },
        "options": {
          "$ref": "#/$defs/AccountFigure"
        },
        "scope": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Scope",
          "type": "string"
        },
        "stock": {
          "$ref": "#/$defs/AccountFigure"
        },
        "whose": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Whose",
          "type": "string"
        }
      },
      "required": [
        "name",
        "net_liquidation",
        "cash",
        "stock",
        "options",
        "scope",
        "whose"
      ],
      "title": "AccountRow",
      "type": "object"
    },
    "AccountScope": {
      "additionalProperties": false,
      "description": "A frame the accounts are counted in (issue #1680): ``household`` (the groups the group file\nnames, me and spouse together) or one scope for each other group (the daughter, apart).\nNothing is summed across scopes.",
      "properties": {
        "accounts": {
          "items": {
            "$ref": "#/$defs/AccountTag"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Accounts",
          "type": "array"
        },
        "key": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "accounts"
      ],
      "title": "AccountScope",
      "type": "object"
    },
    "AccountTag": {
      "additionalProperties": false,
      "description": "One account, named without its alias (issue #1680): ``label`` (``账户（本人）``, ``Flex\n账户（配偶）``) and ``whose`` (``本人``, ``配偶``, ``女儿``), both written by Python from the\naccount's group. In the concentration table ``amount`` is what the account holds of the name.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyCell"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "whose": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Whose",
          "type": "string"
        }
      },
      "required": [
        "label",
        "whose"
      ],
      "title": "AccountTag",
      "type": "object"
    },
    "AccountsBlock": {
      "additionalProperties": false,
      "description": "The account table: ``columns`` are the heads written by Python, six, in the order of the\ncells of a row: the name first, 数据日 last. No row is not a gap.",
      "properties": {
        "columns": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Columns",
          "type": "array"
        },
        "meaning": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/AccountRow"
          },
          "maxItems": 20,
          "minItems": 0,
          "title": "Rows",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "meaning",
        "columns",
        "rows"
      ],
      "title": "AccountsBlock",
      "type": "object"
    },
    "AllocationBlock": {
      "additionalProperties": false,
      "properties": {
        "approx_usd_total": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdFigure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/Gap"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "heads": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxItems": 5,
              "minItems": 5,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heads"
        },
        "meaning": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/AllocationRow"
          },
          "maxItems": 60,
          "minItems": 0,
          "title": "Rows",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "totals": {
          "items": {
            "$ref": "#/$defs/MoneyCell"
          },
          "maxItems": 2,
          "title": "Totals",
          "type": "array"
        }
      },
      "required": [
        "title",
        "meaning",
        "rows",
        "totals"
      ],
      "title": "AllocationBlock",
      "type": "object"
    },
    "AllocationRow": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/MoneyCell"
        },
        "difference": {
          "anyOf": [
            {
              "$ref": "#/$defs/PercentagePointsFigure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "share": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetSharePercentFigure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/SharePercentFigure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "amount"
      ],
      "title": "AllocationRow",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "description": "A named data gap, used in place of a figure that cannot be computed. Never a zero.",
      "properties": {
        "reason": {
          "enum": [
            "missing_quote",
            "no_data",
            "unsupported_currency",
            "not_built",
            "no_reader",
            "no_news_source",
            "no_rule",
            "market_closed",
            "stale",
            "flex_time_unknown",
            "jp_slice_missing",
            "missing_input",
            "stale_input"
          ],
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "text"
      ],
      "title": "Gap",
      "type": "object"
    },
    "IncomeItem": {
      "additionalProperties": false,
      "description": "One item of a month of 每月收入 (issue #1682): ``part`` (``期权``, ``股息``, ``利息``), ``item``\n(``AAA 11-20 P250 平仓``, ``BBB 股息``, ``利息``) and the account's tag, all written by Python.",
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountTag"
        },
        "amount": {
          "$ref": "#/$defs/MoneyCell"
        },
        "item": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Item",
          "type": "string"
        },
        "part": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Part",
          "type": "string"
        }
      },
      "required": [
        "part",
        "item",
        "account",
        "amount"
      ],
      "title": "IncomeItem",
      "type": "object"
    },
    "MoneyBlock": {
      "additionalProperties": false,
      "description": "Rows of money. ``totals`` has one cell per currency present, ``approx_usd_total`` the\ndisplay-only total of all rows in ≈USD (None without a JPY row, or without a rate).\n\n``columns`` are the heads of the table, written by Python: for the obligations block four,\nthe name, the expiry (``MoneyRow.due``), the open price (``MoneyRow.open_price``) and the\namount, in that order; None in the other\nblocks. ``total_labels`` has one label per cell of ``totals``, in the same order, and\n``approx_usd_label`` is the label of ``approx_usd_total``; both None where the block has no\nlabels (the table then names a total row by the block's title).",
      "properties": {
        "approx_usd_label": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approx Usd Label"
        },
        "approx_usd_total": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdFigure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "columns": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/Gap"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "heads": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heads"
        },
        "meaning": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/MoneyRow"
          },
          "maxItems": 60,
          "minItems": 0,
          "title": "Rows",
          "type": "array"
        },
        "scope_gaps": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ScopeGap"
              },
              "maxItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Gaps"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "total_labels": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Labels"
        },
        "totals": {
          "items": {
            "$ref": "#/$defs/MoneyCell"
          },
          "maxItems": 2,
          "title": "Totals",
          "type": "array"
        }
      },
      "required": [
        "title",
        "meaning",
        "rows",
        "totals"
      ],
      "title": "MoneyBlock",
      "type": "object"
    },
    "MoneyCell": {
      "additionalProperties": false,
      "description": "A money cell with a currency and, for JPY, an optional display-only ``approx_usd``.",
      "properties": {
        "approx_usd": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdFigure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "currency": {
          "enum": [
            "USD",
            "JPY"
          ],
          "title": "Currency",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "anyOf": [
            {
              "enum": [
                "up",
                "down",
                "flat",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tone"
        },
        "unit": {
          "enum": [
            "usd",
            "usd_per_share",
            "usd_signed"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": -1000000000,
          "multipleOf": 0.01,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "text",
        "unit",
        "currency"
      ],
      "title": "MoneyCell",
      "type": "object"
    },
    "MoneyRow": {
      "additionalProperties": false,
      "properties": {
        "accounts": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/AccountTag"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accounts"
        },
        "amount": {
          "$ref": "#/$defs/MoneyCell"
        },
        "due": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due"
        },
        "items": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/IncomeItem"
              },
              "maxItems": 200,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Items"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "open_price": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpenPrice"
            },
            {
              "$ref": "#/$defs/Gap"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open Price"
        },
        "scope": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "share": {
          "anyOf": [
            {
              "$ref": "#/$defs/SharePercentFigure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "name",
        "amount"
      ],
      "title": "MoneyRow",
      "type": "object"
    },
    "MoverRow": {
      "additionalProperties": false,
      "description": "One line of the 股票 or the 期权 table of 谁带动了今天 (issue #1681). ``name`` is written by\nPython (``AAA``, ``AAA 11-20 P250``, ``AAA 11-20 P250/240 价差 ×1``); ``previous`` and\n``current`` are the marks of the previous snapshot and of the day, or the gap words when one is\nmissing, never 0; ``amount`` is the day's money in USD, None when a price or a rate is missing\n(``note`` then says which rate). ``scope`` is the key of the scope the line sits under and\n``account`` the tag of its account.",
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountTag"
        },
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyCell"
            },
            {
              "type": "null"
            }
          ]
        },
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/PriceCell"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Current"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/PriceCell"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Previous"
        },
        "scope": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "name",
        "previous",
        "current",
        "amount",
        "scope",
        "account"
      ],
      "title": "MoverRow",
      "type": "object"
    },
    "MoversBlock": {
      "additionalProperties": false,
      "description": "谁带动了今天 (issue #1681): ``stocks`` and ``options`` apart, each line under its scope; ``rows``\nare the 其他 line (the part of the household's change that is no listed position), once, in the\nhousehold scope. ``totals`` is the household scope's change: its lines and the 其他 line, the\ndaughter's lines are in no total. ``scope_gaps`` says in one line that a scope has an account\nwithout intraday prices (``无盘中价格（Flex）``).",
      "properties": {
        "approx_usd_total": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdFigure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "columns": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/Gap"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "meaning": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/MoverRow"
          },
          "maxItems": 60,
          "minItems": 0,
          "title": "Options",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/MoneyRow"
          },
          "maxItems": 60,
          "minItems": 0,
          "title": "Rows",
          "type": "array"
        },
        "scope_gaps": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ScopeGap"
              },
              "maxItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Gaps"
        },
        "stocks": {
          "items": {
            "$ref": "#/$defs/MoverRow"
          },
          "maxItems": 60,
          "minItems": 0,
          "title": "Stocks",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "totals": {
          "items": {
            "$ref": "#/$defs/MoneyCell"
          },
          "maxItems": 2,
          "title": "Totals",
          "type": "array"
        }
      },
      "required": [
        "title",
        "meaning",
        "rows",
        "totals"
      ],
      "title": "MoversBlock",
      "type": "object"
    },
    "NetSharePercentFigure": {
      "additionalProperties": false,
      "description": "A share of the household net liquidation in whole percent (issue #1632): negative for a\nnegative cash, and over 100 is possible, so it is not a ``SharePercentFigure``.",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "share_percent",
          "title": "Unit",
