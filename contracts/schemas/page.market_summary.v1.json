{
  "$defs": {
    "Card": {
      "additionalProperties": false,
      "properties": {
        "chart": {
          "$ref": "#/$defs/Chart"
        },
        "data_times_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Data Times Text",
          "type": "string"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/Gap"
          },
          "maxItems": 20,
          "title": "Gaps",
          "type": "array"
        },
        "index_table": {
          "$ref": "#/$defs/IndexTable"
        },
        "notes": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Notes",
          "type": "array"
        },
        "say": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Say",
          "type": "string"
        },
        "stale": {
          "$ref": "#/$defs/StaleLabel"
        },
        "subtitle": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Subtitle",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "vol_indices": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/VolIndexItem"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vol Indices"
        },
        "vol_indices_note": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vol Indices Note"
        }
      },
      "required": [
        "title",
        "say",
        "subtitle",
        "stale",
        "chart",
        "index_table",
        "notes",
        "gaps",
        "data_times_text"
      ],
      "title": "Card",
      "type": "object"
    },
    "Chart": {
      "additionalProperties": false,
      "properties": {
        "aria_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Aria Text",
          "type": "string"
        },
        "end_labels": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "End Labels",
          "type": "array"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ChartPoint"
          },
          "maxItems": 120,
          "title": "Points",
          "type": "array"
        },
        "series_names": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Series Names",
          "type": "array"
        }
      },
      "required": [
        "points",
        "series_names",
        "end_labels",
        "aria_text"
      ],
      "title": "Chart",
      "type": "object"
    },
    "ChartPoint": {
      "additionalProperties": false,
      "description": "One day: every level is a plain number or ``None`` (null) for a missing day.",
      "properties": {
        "band_high": {
          "anyOf": [
            {
              "maximum": 1000000000.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Band High"
        },
        "band_low": {
          "anyOf": [
            {
              "maximum": 1000000000.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Band Low"
        },
        "close": {
          "anyOf": [
            {
              "maximum": 1000000000.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Close"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "ma200": {
          "anyOf": [
            {
              "maximum": 1000000000.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ma200"
        }
      },
      "required": [
        "label",
        "close",
        "ma200",
        "band_low",
        "band_high"
      ],
      "title": "ChartPoint",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "description": "A named data gap, used in place of a figure that cannot be computed. Never a zero.",
      "properties": {
        "reason": {
          "enum": [
            "missing_quote",
            "no_data",
            "unsupported_currency",
            "not_built",
            "no_reader",
            "no_news_source",
            "no_rule",
            "market_closed",
            "stale",
            "flex_time_unknown",
            "jp_slice_missing",
            "missing_input",
            "stale_input"
          ],
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "text"
      ],
      "title": "Gap",
      "type": "object"
    },
    "IndexLevelFigure": {
      "additionalProperties": false,
      "description": "The level of a published market index in index points as its publisher states it (a Cboe\nvolatility index: 18.20 is 18.20 points). Not the 0 to 100 ease scale of ``IndexPointsFigure``:\nthe level has no upper bound in practice, the cap here only rejects a corrupt value.",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "index_points",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000.0,
          "minimum": 0,
          "title": "Value",
          "type": "number",
          "x-decimals": 1,
          "x-rounding": "ROUND_HALF_UP"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "IndexLevelFigure",
      "type": "object"
    },
    "IndexRow": {
      "additionalProperties": false,
      "properties": {
        "iv": {
          "anyOf": [
            {
              "$ref": "#/$defs/VolPointsFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Iv"
        },
        "iv_minus_rv20": {
          "anyOf": [
            {
              "$ref": "#/$defs/VolPointsFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Iv Minus Rv20"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "rv20": {
          "anyOf": [
            {
              "$ref": "#/$defs/VolPointsFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Rv20"
        },
        "source_text": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        }
      },
      "required": [
        "name",
        "iv",
        "rv20",
        "iv_minus_rv20"
      ],
      "title": "IndexRow",
      "type": "object"
    },
    "IndexTable": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/IndexRow"
          },
          "maxItems": 10,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "IndexTable",
      "type": "object"
    },
    "SourceTime": {
      "additionalProperties": false,
      "description": "The data time of one source behind the card.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "source": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "data_time"
      ],
      "title": "SourceTime",
      "type": "object"
    },
    "StaleLabel": {
      "additionalProperties": false,
      "description": "Python sends the times and the label; the browser only compares its clock with ``stale_after``.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "stale_after": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Stale After",
          "type": "string",
          "x-timezone": "owner"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "data_time",
        "stale_after",
        "text"
      ],
      "title": "StaleLabel",
      "type": "object"
    },
    "VolIndexItem": {
      "additionalProperties": false,
      "description": "One Cboe volatility index (VIX, VXN, RVX): its level in index points as Cboe publishes it\n(18.20 is 18.20 points, not a fraction and not a percent), the data day ``mm-dd`` and the\nsource series. Never part of the IV cell of the index table: a Cboe index is a methodology of\nits own.",
      "properties": {
        "day": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Day",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndexLevelFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Level"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Text",
          "type": "string"
        }
      },
      "required": [
        "name",
        "level",
        "day",
        "source_text"
      ],
      "title": "VolIndexItem",
      "type": "object"
    },
    "VolPointsFigure": {
      "additionalProperties": false,
      "description": "Vol points (GLOSSARY \"Vol point\"), signed (``+2.1``).",
      "properties": {
        "source": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "anyOf": [
            {
              "enum": [
                "up",
                "down",
                "flat",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tone"
        },
        "unit": {
          "const": "vol_points",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000,
          "minimum": -1000,
          "title": "Value",
          "type": "number",
          "x-decimals": 1,
          "x-rounding": "ROUND_HALF_UP"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "VolPointsFigure",
      "type": "object"
    }
  },
  "$id": "https://option-trader.invalid/schemas/market_summary.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Envelope (ADR 0034) and card.",
  "properties": {
    "build_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Build Id",
      "type": "string"
    },
    "card": {
      "$ref": "#/$defs/Card"
    },
    "data_times": {
      "items": {
        "$ref": "#/$defs/SourceTime"
      },
      "maxItems": 20,
      "title": "Data Times",
      "type": "array"
    },
    "generated_at": {
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
      "title": "Generated At",
      "type": "string",
      "x-timezone": "owner"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "schema": {
      "const": "market_summary",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "card"
  ],
  "title": "MarketSummary",
  "type": "object"
}
