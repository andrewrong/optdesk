{
  "$defs": {
    "CellAt": {
      "additionalProperties": false,
      "description": "The cell of one column of a row (a list, not a map: the writer walks lists and dataclasses).",
      "properties": {
        "cell": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdAmount"
            },
            {
              "$ref": "#/$defs/JpyAmount"
            },
            {
              "$ref": "#/$defs/PercentAmount"
            },
            {
              "$ref": "#/$defs/VolAmount"
            },
            {
              "$ref": "#/$defs/CountAmount"
            },
            {
              "$ref": "#/$defs/TextCell"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Cell"
        },
        "column": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Column",
          "type": "string"
        }
      },
      "required": [
        "column",
        "cell"
      ],
      "title": "CellAt",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Align",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "align"
      ],
      "title": "Column",
      "type": "object"
    },
    "CountAmount": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "contracts",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "CountAmount",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "description": "A named data gap, used in place of a figure that cannot be computed. Never a zero.",
      "properties": {
        "reason": {
          "enum": [
            "missing_quote",
            "no_data",
            "unsupported_currency",
            "not_built",
            "no_reader",
            "no_news_source",
            "no_rule",
            "market_closed",
            "stale",
            "flex_time_unknown",
            "jp_slice_missing",
            "missing_input",
            "stale_input"
          ],
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "text"
      ],
      "title": "Gap",
      "type": "object"
    },
    "JpyAmount": {
      "additionalProperties": false,
      "description": "A price in Japanese yen (GLOSSARY: JPY with ≈USD). ``approx_usd`` is the display-only\nfigure Python made from the stored JPY per USD rate; without a stored rate it is absent.",
      "properties": {
        "approx_usd": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdAmount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "jpy",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "JpyAmount",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "href": {
          "pattern": "^(?:/|/[A-Za-z0-9_-][A-Za-z0-9_/-]*)$",
          "title": "Href",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "href"
      ],
      "title": "Link",
      "type": "object"
    },
    "PercentAmount": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "percent",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "PercentAmount",
      "type": "object"
    },
    "Row": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/CellAt"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Cells",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "cells"
      ],
      "title": "Row",
      "type": "object"
    },
    "ScanSection": {
      "additionalProperties": false,
      "description": "One strategy: a table with its sub line (and liquidity sentence), or the Gap and no table.",
      "properties": {
        "gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/Gap"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "liquidity": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Liquidity"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "strategy": {
          "enum": [
            "short_put",
            "covered_call",
            "put_credit_spread"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "sub": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sub"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScanTable"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "title"
      ],
      "title": "ScanSection",
      "type": "object"
    },
    "ScanTable": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/Row"
          },
          "maxItems": 2000,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "ScanTable",
      "type": "object"
    },
    "SourceTime": {
      "additionalProperties": false,
      "description": "The data time of one source behind the card.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "source": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "data_time"
      ],
      "title": "SourceTime",
      "type": "object"
    },
    "StaleLabel": {
      "additionalProperties": false,
      "description": "Python sends the times and the label; the browser only compares its clock with ``stale_after``.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "stale_after": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Stale After",
          "type": "string",
          "x-timezone": "owner"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "data_time",
        "stale_after",
        "text"
      ],
      "title": "StaleLabel",
      "type": "object"
    },
    "TextCell": {
      "additionalProperties": false,
      "description": "A text cell; ``value`` is the sort key (a rank for a verdict, the symbol for a name).",
      "properties": {
        "badge": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Badge"
        },
        "kind": {
          "const": "text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "TextCell",
      "type": "object"
    },
    "UsdAmount": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "usd",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "UsdAmount",
      "type": "object"
    },
    "VolAmount": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "vol_points",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000,
          "minimum": -1000,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "VolAmount",
      "type": "object"
    }
  },
  "$id": "https://option-trader.invalid/schemas/full_scan.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Envelope (ADR 0034) and the page.",
  "properties": {
    "back": {
      "$ref": "#/$defs/Link"
    },
    "build_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Build Id",
      "type": "string"
    },
    "data_times": {
      "items": {
        "$ref": "#/$defs/SourceTime"
      },
      "maxItems": 20,
      "title": "Data Times",
      "type": "array"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "maxItems": 20,
      "title": "Gaps",
      "type": "array"
    },
    "generated_at": {
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
      "title": "Generated At",
      "type": "string",
      "x-timezone": "owner"
    },
    "notes": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Notes",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "schema": {
      "const": "full_scan",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Scope",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ScanSection"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Sections",
      "type": "array"
    },
    "stale": {
      "anyOf": [
        {
          "$ref": "#/$defs/StaleLabel"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "title",
    "stale",
    "back",
    "sections",
    "notes",
    "gaps"
  ],
  "title": "FullScan",
  "type": "object"
}
