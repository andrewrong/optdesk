{
  "$defs": {
    "Ease": {
      "additionalProperties": false,
      "properties": {
        "aria_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Aria Text",
          "type": "string"
        },
        "figure": {
          "$ref": "#/$defs/IndexPointsFigure"
        },
        "marker_percent": {
          "$ref": "#/$defs/PercentOfTrackFigure"
        },
        "neutral_band": {
          "$ref": "#/$defs/NeutralBand"
        },
        "reading_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reading Text",
          "type": "string"
        },
        "ticks": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Ticks",
          "type": "array"
        },
        "week_change": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndexPointsFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Week Change"
        }
      },
      "required": [
        "figure",
        "week_change",
        "marker_percent",
        "neutral_band",
        "ticks",
        "reading_text",
        "aria_text"
      ],
      "title": "Ease",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
          "title": "Date",
          "type": "string"
        },
        "name_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name Text",
          "type": "string"
        },
        "previous": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Previous"
        },
        "when_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "When Text",
          "type": "string"
        }
      },
      "required": [
        "date",
        "when_text",
        "name_text",
        "previous"
      ],
      "title": "Event",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "description": "A named data gap, used in place of a figure that cannot be computed. Never a zero.",
      "properties": {
        "reason": {
          "enum": [
            "missing_quote",
            "no_data",
            "unsupported_currency",
            "not_built",
            "no_reader",
            "no_news_source",
            "no_rule",
            "market_closed",
            "stale",
            "flex_time_unknown",
            "jp_slice_missing",
            "missing_input",
            "stale_input"
          ],
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "text"
      ],
      "title": "Gap",
      "type": "object"
    },
    "IndexPointsFigure": {
      "additionalProperties": false,
      "description": "A position on the stored 0 to 100 ease scale, or a change in it.",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "anyOf": [
            {
              "enum": [
                "up",
                "down",
                "flat",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tone"
        },
        "unit": {
          "const": "index_points",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 100,
          "minimum": -100,
          "title": "Value",
          "type": "number",
          "x-decimals": 1,
          "x-rounding": "ROUND_HALF_UP"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "IndexPointsFigure",
      "type": "object"
    },
    "Indicator": {
      "additionalProperties": false,
      "properties": {
        "detail_href": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail Href"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "latest": {
          "anyOf": [
            {
              "$ref": "#/$defs/PercentFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Latest"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Text",
          "type": "string"
        },
        "status": {
          "enum": [
            "good",
            "late",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "latest",
        "status",
        "label",
        "source_text",
        "detail_href"
      ],
      "title": "Indicator",
      "type": "object"
    },
    "NeutralBand": {
      "additionalProperties": false,
      "description": "The ends of the neutral band on the track, ``percent_of_track``.",
      "properties": {
        "high": {
          "$ref": "#/$defs/PercentOfTrackFigure"
        },
        "low": {
          "$ref": "#/$defs/PercentOfTrackFigure"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "NeutralBand",
      "type": "object"
    },
    "PercentFigure": {
      "additionalProperties": false,
      "description": "A fraction times 100, signed (``+2.1%``).",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "anyOf": [
            {
              "enum": [
                "up",
                "down",
                "flat",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tone"
        },
        "unit": {
          "const": "percent",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "Value",
          "type": "number",
          "x-decimals": 4,
          "x-rounding": "ROUND_HALF_UP"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "PercentFigure",
      "type": "object"
    },
    "PercentOfTrackFigure": {
      "additionalProperties": false,
      "description": "A marker position on its track, 0 to 100.",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "percent_of_track",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 100,
          "minimum": 0,
          "title": "Value",
          "type": "number",
          "x-decimals": 2,
          "x-rounding": "ROUND_HALF_UP"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "PercentOfTrackFigure",
      "type": "object"
    },
    "SourceTime": {
      "additionalProperties": false,
      "description": "The data time of one source behind the card.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "source": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "data_time"
      ],
      "title": "SourceTime",
      "type": "object"
    },
    "StaleLabel": {
      "additionalProperties": false,
      "description": "Python sends the times and the label; the browser only compares its clock with ``stale_after``.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "stale_after": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Stale After",
          "type": "string",
          "x-timezone": "owner"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "data_time",
        "stale_after",
        "text"
      ],
      "title": "StaleLabel",
      "type": "object"
    }
  },
  "$id": "https://option-trader.invalid/schemas/macro_page.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Build Id",
      "type": "string"
    },
    "data_times": {
      "items": {
        "$ref": "#/$defs/SourceTime"
      },
      "maxItems": 20,
      "title": "Data Times",
      "type": "array"
    },
    "ease": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ease"
        },
        {
          "$ref": "#/$defs/Gap"
        }
      ],
      "title": "Ease"
    },
    "ease_title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Ease Title",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "maxItems": 20,
      "title": "Events",
      "type": "array"
    },
    "events_title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Events Title",
      "type": "string"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "maxItems": 20,
      "title": "Gaps",
      "type": "array"
    },
    "generated_at": {
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
      "title": "Generated At",
      "type": "string",
      "x-timezone": "owner"
    },
    "indicators": {
      "items": {
        "$ref": "#/$defs/Indicator"
      },
      "maxItems": 20,
      "title": "Indicators",
      "type": "array"
    },
    "indicators_title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Indicators Title",
      "type": "string"
    },
    "notes": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Notes",
      "type": "array"
    },
    "notes_title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Notes Title",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "schema": {
      "const": "macro_page",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Scope",
      "type": "string"
    },
    "sentence": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Sentence",
      "type": "string"
    },
    "stale": {
      "$ref": "#/$defs/StaleLabel"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "title",
    "sentence",
    "ease_title",
    "events_title",
    "indicators_title",
    "notes_title",
    "ease",
    "events",
    "indicators",
    "notes",
    "gaps",
    "stale"
  ],
  "title": "MacroPage",
  "type": "object"
}
