{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optdesk.invalid/schemas/page.company_quarters_page.v1.json",
  "title": "CompanyQuartersPage",
  "description": "View model of the quarterly table of one company: one row per fiscal quarter, one cell per figure, each cell with its flags and the reason when it has no value. The builder computes every figure and text; the view computes nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "run_id", "built_at", "company", "choices", "columns", "quarters", "notes", "gaps"],
  "properties": {
    "schema": {"const": "company_quarters_page", "type": "string"},
    "schema_version": {"const": 1, "type": "integer"},
    "run_id": {"$ref": "common.v2.json#/$defs/Id"},
    "built_at": {"$ref": "common.v2.json#/$defs/Timestamp"},
    "company": {"oneOf": [{"$ref": "#/$defs/Company"}, {"type": "null"}]},
    "choices": {"type": "array", "items": {"$ref": "#/$defs/Choice"}},
    "columns": {"type": "array", "items": {"$ref": "#/$defs/Column"}},
    "quarters": {"type": "array", "items": {"$ref": "#/$defs/Quarter"}},
    "notes": {"type": "array", "items": {"$ref": "#/$defs/Text"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/Gap"}}
  },
  "$defs": {
    "Text": {"type": "string", "minLength": 1, "maxLength": 600},
    "Optional": {"type": "string", "maxLength": 600},
    "Day": {"type": "string", "format": "date"},
    "Company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "symbol", "name", "issuer", "fiscal_year_end"],
      "properties": {
        "key": {"$ref": "#/$defs/Text"},
        "symbol": {"$ref": "#/$defs/Text"},
        "name": {"$ref": "#/$defs/Optional"},
        "issuer": {"$ref": "#/$defs/Optional"},
        "fiscal_year_end": {"$ref": "#/$defs/Optional"}
      }
    },
    "Choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "path"],
      "properties": {
        "key": {"$ref": "#/$defs/Text"},
        "label": {"$ref": "#/$defs/Text"},
        "path": {"$ref": "#/$defs/Text"}
      }
    },
    "Column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "gloss"],
      "properties": {
        "key": {"$ref": "#/$defs/Text"},
        "label": {"$ref": "#/$defs/Text"},
        "gloss": {"$ref": "#/$defs/Optional"}
      }
    },
    "Cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "missing", "derived", "restated", "concept", "why_text"],
      "properties": {
        "text": {"$ref": "#/$defs/Optional"},
        "missing": {"type": "boolean"},
        "derived": {"type": "boolean"},
        "restated": {"type": "boolean"},
        "concept": {"$ref": "#/$defs/Optional"},
        "why_text": {"$ref": "#/$defs/Optional"}
      }
    },
    "Quarter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "period_end", "filing_date", "cells"],
      "properties": {
        "label": {"$ref": "#/$defs/Optional"},
        "period_end": {"$ref": "#/$defs/Day"},
        "filing_date": {"oneOf": [{"$ref": "#/$defs/Day"}, {"type": "null"}]},
        "cells": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Cell"}}
      }
    },
    "Gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "text"],
      "properties": {
        "kind": {"const": "gap"},
        "reason": {"type": "string", "pattern": "^[a-z_]{1,48}$"},
        "text": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}
