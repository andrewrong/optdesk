{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optdesk.invalid/schemas/page.option_notices_page.v1.json",
  "title": "OptionNoticesPage",
  "description": "The option notices page: one block per account alias with its notices, cash by date and cushion text. A render of rows a producer writes; nothing is computed here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "stale",
    "title",
    "notes",
    "gaps",
    "day",
    "accounts"
  ],
  "properties": {
    "schema": {
      "const": "option_notices_page",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "run_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "build_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "scope": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "generated_at": {
      "$ref": "common.v2.json#/$defs/Timestamp"
    },
    "data_times": {
      "type": "array",
      "items": {
        "$ref": "common.v2.json#/$defs/SourceTime"
      }
    },
    "run_status": {
      "$ref": "common.v2.json#/$defs/RunStatus"
    },
    "stale": {
      "oneOf": [
        {
          "$ref": "common.v2.json#/$defs/StaleLabel"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "$ref": "#/$defs/Text"
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Text"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Gap"
      }
    },
    "day": {
      "description": "The build day, an ISO date.",
      "$ref": "#/$defs/Day"
    },
    "accounts": {
      "description": "One block per alias, the main alias first.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AliasBlock"
      }
    },
    "stale_after": {
      "$ref": "common.v2.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "Day": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "NullableDay": {
      "oneOf": [
        {
          "$ref": "#/$defs/Day"
        },
        {
          "type": "null"
        }
      ]
    },
    "NullableText": {
      "oneOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ]
    },
    "AliasBlock": {
      "description": "The notices of one account alias. status is ok, no_capture (no stored capture, note says why) or stale (the data day is older than the build day).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "main",
        "status",
        "data_day",
        "notices",
        "cash_by_date",
        "cushion_text",
        "note"
      ],
      "properties": {
        "alias": {
          "$ref": "#/$defs/Text"
        },
        "main": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "no_capture",
            "stale"
          ]
        },
        "data_day": {
          "$ref": "#/$defs/NullableDay"
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NoticeRow"
          }
        },
        "cash_by_date": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CashRow"
          }
        },
        "cushion_text": {
          "$ref": "#/$defs/NullableText"
        },
        "note": {
          "$ref": "#/$defs/NullableText"
        }
      }
    },
    "NoticeRow": {
      "description": "One notice. code is a pattern, not an enum, so a new code needs no schema change.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "severity",
        "title",
        "contract",
        "expiry",
        "facts",
        "reasons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^notice-[A-Za-z0-9_-]{1,64}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warn",
            "act"
          ]
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "contract": {
          "$ref": "#/$defs/Text"
        },
        "expiry": {
          "$ref": "#/$defs/NullableDay"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          }
        }
      }
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "text"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/Text"
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "CashRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "currency",
        "amount_text"
      ],
      "properties": {
        "day": {
          "$ref": "#/$defs/Day"
        },
        "currency": {
          "$ref": "#/$defs/Text"
        },
        "amount_text": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "Gap": {
      "description": "A named data gap, used in place of a value that cannot be shown. Never a zero.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "gap",
          "type": "string"
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$"
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      }
    }
  }
}
