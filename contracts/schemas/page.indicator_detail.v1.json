{
  "$defs": {
    "DateText": {
      "additionalProperties": false,
      "description": "A calendar date and its written form.",
      "properties": {
        "day": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$",
          "title": "Day",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "day",
        "text"
      ],
      "title": "DateText",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "description": "A named data gap, used in place of a figure that cannot be computed. Never a zero.",
      "properties": {
        "reason": {
          "enum": [
            "missing_quote",
            "no_data",
            "unsupported_currency",
            "not_built",
            "no_reader",
            "no_news_source",
            "no_rule",
            "market_closed",
            "stale",
            "flex_time_unknown",
            "jp_slice_missing",
            "missing_input",
            "stale_input"
          ],
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "text"
      ],
      "title": "Gap",
      "type": "object"
    },
    "Latest": {
      "additionalProperties": false,
      "description": "The newest stored point: its value, the day observed and the day released (or a ``Gap``).",
      "properties": {
        "observed": {
          "$ref": "#/$defs/DateText"
        },
        "released": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateText"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Released"
        },
        "value": {
          "$ref": "#/$defs/SeriesFigure"
        }
      },
      "required": [
        "value",
        "observed",
        "released"
      ],
      "title": "Latest",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "observed_on": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$",
          "title": "Observed On",
          "type": "string"
        },
        "released": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateText"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Released"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": -1000000000,
          "title": "Value",
          "type": "number"
        },
        "vintage_on": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$",
          "title": "Vintage On",
          "type": "string"
        }
      },
      "required": [
        "observed_on",
        "value",
        "text",
        "vintage_on",
        "released"
      ],
      "title": "Point",
      "type": "object"
    },
    "ReferenceLine": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/SeriesFigure"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "ReferenceLine",
      "type": "object"
    },
    "Revision": {
      "additionalProperties": false,
      "description": "The previous vintage of the latest observation and the step from it to the shown value.",
      "properties": {
        "previous": {
          "$ref": "#/$defs/SeriesFigure"
        },
        "step": {
          "$ref": "#/$defs/SeriesFigure"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "vintage": {
          "$ref": "#/$defs/DateText"
        }
      },
      "required": [
        "previous",
        "vintage",
        "step",
        "text"
      ],
      "title": "Revision",
      "type": "object"
    },
    "SeriesFigure": {
      "additionalProperties": false,
      "description": "A value of the series, or a difference of two of its values (``series_change``).",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "enum": [
            "series_value",
            "series_change"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": -1000000000,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "SeriesFigure",
      "type": "object"
    },
    "SourceTime": {
      "additionalProperties": false,
      "description": "The data time of one source behind the card.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "source": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "data_time"
      ],
      "title": "SourceTime",
      "type": "object"
    },
    "StaleLabel": {
      "additionalProperties": false,
      "description": "Python sends the times and the label; the browser only compares its clock with ``stale_after``.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "stale_after": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Stale After",
          "type": "string",
          "x-timezone": "owner"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "data_time",
        "stale_after",
        "text"
      ],
      "title": "StaleLabel",
      "type": "object"
    }
  },
  "$id": "https://option-trader.invalid/schemas/indicator_detail.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Build Id",
      "type": "string"
    },
    "data_times": {
      "items": {
        "$ref": "#/$defs/SourceTime"
      },
      "maxItems": 20,
      "title": "Data Times",
      "type": "array"
    },
    "explanation": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Explanation",
      "type": "array"
    },
    "explanation_title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Explanation Title",
      "type": "string"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "maxItems": 20,
      "title": "Gaps",
      "type": "array"
    },
    "generated_at": {
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
      "title": "Generated At",
      "type": "string",
      "x-timezone": "owner"
    },
    "latest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Latest"
        },
        {
          "$ref": "#/$defs/Gap"
        }
      ],
      "title": "Latest"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/Point"
      },
      "maxItems": 5000,
      "title": "Points",
      "type": "array"
    },
    "reference_line": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReferenceLine"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "schema": {
      "const": "indicator_detail",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Scope",
      "type": "string"
    },
    "sentence": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Sentence",
      "type": "string"
    },
    "series_title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Series Title",
      "type": "string"
    },
    "slug": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Slug",
      "type": "string"
    },
    "stale": {
      "$ref": "#/$defs/StaleLabel"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "slug",
    "title",
    "sentence",
    "latest",
    "revision",
    "reference_line",
    "series_title",
    "explanation_title",
    "points",
    "explanation",
    "gaps",
    "stale"
  ],
  "title": "IndicatorDetail",
  "type": "object"
}
