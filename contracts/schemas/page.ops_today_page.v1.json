{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optdesk.invalid/schemas/page.ops_today_page.v1.json",
  "title": "OpsTodayPage",
  "description": "The same-morning page: one section, today, with the newest run of each market key and a row for each job that is not wired. A render of rows a producer writes; nothing is computed here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "stale",
    "title",
    "notes",
    "gaps",
    "day",
    "today"
  ],
  "properties": {
    "schema": {
      "const": "ops_today_page",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "run_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "build_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "scope": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "generated_at": {
      "$ref": "common.v2.json#/$defs/Timestamp"
    },
    "data_times": {
      "type": "array",
      "items": {
        "$ref": "common.v2.json#/$defs/SourceTime"
      }
    },
    "run_status": {
      "$ref": "common.v2.json#/$defs/RunStatus"
    },
    "stale": {
      "oneOf": [
        {
          "$ref": "common.v2.json#/$defs/StaleLabel"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "$ref": "#/$defs/Text"
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Text"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Gap"
      }
    },
    "day": {
      "description": "The session day, an ISO date.",
      "$ref": "#/$defs/Day"
    },
    "stale_after": {
      "$ref": "common.v2.json#/$defs/Timestamp"
    },
    "today": {
      "description": "The one section: rows ordered by the producer.",
      "$ref": "#/$defs/TodaySection"
    }
  },
  "$defs": {
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "Day": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "NullableText": {
      "oneOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ]
    },
    "Gap": {
      "description": "A named data gap, used in place of a value that cannot be shown. Never a zero.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "gap",
          "type": "string"
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$"
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "TodaySection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Row"
          }
        }
      }
    },
    "Row": {
      "description": "One run row: the newest run of a market key with its reason code, or a not_wired row (reason_code not_wired, the NAME of the missing key in detail, never a value). Every text is the producer's.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "key",
        "market",
        "status",
        "error_code",
        "reason_code",
        "returned_n",
        "usable_n",
        "detail"
      ],
      "properties": {
        "dataset": {
          "$ref": "#/$defs/Text"
        },
        "key": {
          "$ref": "#/$defs/Text"
        },
        "market": {
          "$ref": "#/$defs/Text"
        },
        "status": {
          "$ref": "#/$defs/Text"
        },
        "error_code": {
          "$ref": "#/$defs/NullableText"
        },
        "reason_code": {
          "$ref": "#/$defs/NullableText"
        },
        "returned_n": {
          "description": "Rows returned, as the run recorded it.",
          "type": "integer",
          "minimum": 0
        },
        "usable_n": {
          "description": "Rows usable, as the run recorded it.",
          "type": "integer",
          "minimum": 0
        },
        "detail": {
          "$ref": "#/$defs/NullableText"
        }
      }
    }
  }
}
