{
  "$defs": {
    "CellAt": {
      "additionalProperties": false,
      "description": "The cell of one column of a row (a list, not a map: the writer walks lists and dataclasses).",
      "properties": {
        "cell": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdAmount"
            },
            {
              "$ref": "#/$defs/JpyAmount"
            },
            {
              "$ref": "#/$defs/PercentAmount"
            },
            {
              "$ref": "#/$defs/VolAmount"
            },
            {
              "$ref": "#/$defs/CountAmount"
            },
            {
              "$ref": "#/$defs/TextCell"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Cell"
        },
        "column": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Column",
          "type": "string"
        }
      },
      "required": [
        "column",
        "cell"
      ],
      "title": "CellAt",
      "type": "object"
    },
    "Chain": {
      "additionalProperties": false,
      "description": "One option chain: strike by expiry, the Mid of each contract; the chosen one is marked.",
      "properties": {
        "summary": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "table": {
          "$ref": "#/$defs/Table"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary",
        "table"
      ],
      "title": "Chain",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Align",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "align"
      ],
      "title": "Column",
      "type": "object"
    },
    "CountAmount": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "contracts",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "CountAmount",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "description": "A named data gap, used in place of a figure that cannot be computed. Never a zero.",
      "properties": {
        "reason": {
          "enum": [
            "missing_quote",
            "no_data",
            "unsupported_currency",
            "not_built",
            "no_reader",
            "no_news_source",
            "no_rule",
            "market_closed",
            "stale",
            "flex_time_unknown",
            "jp_slice_missing",
            "missing_input",
            "stale_input"
          ],
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "text"
      ],
      "title": "Gap",
      "type": "object"
    },
    "JpyAmount": {
      "additionalProperties": false,
      "description": "A price in Japanese yen (GLOSSARY: JPY with ≈USD). ``approx_usd`` is the display-only\nfigure Python made from the stored JPY per USD rate; without a stored rate it is absent.",
      "properties": {
        "approx_usd": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdAmount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "jpy",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "JpyAmount",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "description": "A link to a section of the same page: ``target`` is the id of that section.",
      "properties": {
        "target": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Target",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "target"
      ],
      "title": "Link",
      "type": "object"
    },
    "MarketPane": {
      "additionalProperties": false,
      "properties": {
        "all_link": {
          "$ref": "#/$defs/Link"
        },
        "candidates": {
          "$ref": "#/$defs/Table"
        },
        "candidates_title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Candidates Title",
          "type": "string"
        },
        "cards": {
          "items": {
            "$ref": "#/$defs/Opportunity"
          },
          "maxItems": 20,
          "title": "Cards",
          "type": "array"
        },
        "cards_title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Cards Title",
          "type": "string"
        },
        "chain": {
          "anyOf": [
            {
              "$ref": "#/$defs/Chain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "currency": {
          "enum": [
            "USD",
            "JPY"
          ],
          "title": "Currency",
          "type": "string"
        },
        "headline": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "market": {
          "enum": [
            "US",
            "JP"
          ],
          "title": "Market",
          "type": "string"
        }
      },
      "required": [
        "market",
        "label",
        "currency",
        "headline",
        "cards_title",
        "cards",
        "candidates_title",
        "candidates",
        "all_link"
      ],
      "title": "MarketPane",
      "type": "object"
    },
    "Opportunity": {
      "additionalProperties": false,
      "description": "One 今日机会 card.",
      "properties": {
        "annualised": {
          "anyOf": [
            {
              "$ref": "#/$defs/PercentAmount"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Annualised"
        },
        "annualised_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Annualised Text",
          "type": "string"
        },
        "contract_line": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Contract Line",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "iv_line": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Iv Line",
          "type": "string"
        },
        "liquidity_line": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Liquidity Line",
          "type": "string"
        },
        "premium_line": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Premium Line",
          "type": "string"
        },
        "reason": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "size_line": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Size Line",
          "type": "string"
        },
        "size_usd_approx": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdAmount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "tags": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Tags",
          "type": "array"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "id",
        "symbol",
        "verdict",
        "reason",
        "annualised",
        "annualised_text",
        "contract_line",
        "liquidity_line",
        "tags",
        "size_line",
        "iv_line",
        "premium_line"
      ],
      "title": "Opportunity",
      "type": "object"
    },
    "PercentAmount": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "percent",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "PercentAmount",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "description": "The quote behind the prices of one row (docs/design/option-open-pull.md Decision 18): when it was taken (exchange-local HH:MM:SS, or a date text for a close archive value), the market data type of its tick, where it came from, and the two flags of the pull. Copied from the stored row, never computed.",
      "properties": {
        "as_of": {
          "maxLength": 40,
          "minLength": 1,
          "title": "As Of",
          "type": "string"
        },
        "data_type": {
          "anyOf": [
            {
              "enum": [
                "live",
                "frozen",
                "delayed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Data Type",
          "description": "null for a close archive value, which has no tick type."
        },
        "outside_band": {
          "title": "Outside Band",
          "type": "boolean"
        },
        "skew": {
          "title": "Skew",
          "type": "boolean"
        },
        "source": {
          "enum": [
            "open_pull",
            "refresh",
            "close_archive"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "as_of",
        "data_type",
        "source",
        "skew",
        "outside_band"
      ],
      "title": "Quote",
      "type": "object"
    },
    "Refresh": {
      "additionalProperties": false,
      "description": "The state of the refresh button (Decisions 13 to 20): copied by the builder from the route; the web computes nothing. When enabled is false the notice says why.",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "fresh_count": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Fresh Count",
          "type": "integer"
        },
        "notice": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notice"
        },
        "symbols": {
          "items": {
            "pattern": "^[A-Za-z0-9._-]{1,32}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Symbols",
          "type": "array"
        },
        "total_count": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Total Count",
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "symbols",
        "notice",
        "fresh_count",
        "total_count"
      ],
      "title": "Refresh",
      "type": "object"
    },
    "Row": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/CellAt"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Cells",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "quote": {
          "$ref": "#/$defs/Quote"
        }
      },
      "required": [
        "id",
        "cells",
        "quote"
      ],
      "title": "Row",
      "type": "object"
    },
    "SourceTime": {
      "additionalProperties": false,
      "description": "The data time of one source behind the card.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "source": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "data_time"
      ],
      "title": "SourceTime",
      "type": "object"
    },
    "StaleLabel": {
      "additionalProperties": false,
      "description": "Python sends the times and the label; the browser only compares its clock with ``stale_after``.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "stale_after": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Stale After",
          "type": "string",
          "x-timezone": "owner"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "data_time",
        "stale_after",
        "text"
      ],
      "title": "StaleLabel",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/Row"
          },
          "maxItems": 200,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "Table",
      "type": "object"
    },
    "TextCell": {
      "additionalProperties": false,
      "description": "A text cell; ``value`` is the sort key (a rank for a verdict, the symbol for a name).",
      "properties": {
        "badge": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Badge"
        },
        "kind": {
          "const": "text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "TextCell",
      "type": "object"
    },
    "UsdAmount": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "usd",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "UsdAmount",
      "type": "object"
    },
    "Verdict": {
      "additionalProperties": false,
      "description": "Written by Python; the browser never derives it from the figures.",
      "properties": {
        "key": {
          "enum": [
            "worth",
            "marginal",
            "pending",
            "skip"
          ],
          "title": "Key",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "tone": {
          "enum": [
            "good",
            "warn",
            "neutral",
            "muted"
          ],
          "title": "Tone",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "tone"
      ],
      "title": "Verdict",
      "type": "object"
    },
    "VolAmount": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "vol_points",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000,
          "minimum": -1000,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "VolAmount",
      "type": "object"
    }
  },
  "$id": "https://optdesk.invalid/schemas/page.option_page.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Envelope (ADR 0034) and the page.",
  "properties": {
    "build_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Build Id",
      "type": "string"
    },
    "data_times": {
      "items": {
        "$ref": "#/$defs/SourceTime"
      },
      "maxItems": 20,
      "title": "Data Times",
      "type": "array"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "maxItems": 20,
      "title": "Gaps",
      "type": "array"
    },
    "generated_at": {
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
      "title": "Generated At",
      "type": "string",
      "x-timezone": "owner"
    },
    "markets": {
      "items": {
        "$ref": "#/$defs/MarketPane"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Markets",
      "type": "array"
    },
    "notes": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Notes",
      "type": "array"
    },
    "refresh": {
      "$ref": "#/$defs/Refresh"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "schema": {
      "const": "option_page",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Scope",
      "type": "string"
    },
    "stale": {
      "$ref": "#/$defs/StaleLabel"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
