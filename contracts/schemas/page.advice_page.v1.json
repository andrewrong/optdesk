{
  "$defs": {
    "AdviceRow": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "$ref": "#/$defs/TextCell"
        },
        "acted": {
          "$ref": "#/$defs/TextCell"
        },
        "after_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/FigureCell"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "After Value"
        },
        "delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/FigureCell"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Delta"
        },
        "ref_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/FigureCell"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Ref Value"
        },
        "sentence": {
          "$ref": "#/$defs/TextCell"
        }
      },
      "required": [
        "sentence",
        "account",
        "ref_value",
        "after_value",
        "delta",
        "acted"
      ],
      "title": "AdviceRow",
      "type": "object"
    },
    "FigureCell": {
      "additionalProperties": false,
      "description": "A per-share figure (GLOSSARY \"Prices and premiums\"): two decimals in ``value`` and ``text``.",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": -1000000000,
          "multipleOf": 0.01,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "text",
        "value"
      ],
      "title": "FigureCell",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "description": "A named data gap, used in place of a figure that cannot be computed. Never a zero.",
      "properties": {
        "reason": {
          "enum": [
            "missing_quote",
            "no_data",
            "unsupported_currency",
            "not_built",
            "no_reader",
            "no_news_source",
            "no_rule",
            "market_closed",
            "stale",
            "flex_time_unknown",
            "jp_slice_missing",
            "missing_input",
            "stale_input"
          ],
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "text"
      ],
      "title": "Gap",
      "type": "object"
    },
    "SourceTime": {
      "additionalProperties": false,
      "description": "The data time of one source behind the card.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "source": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "data_time"
      ],
      "title": "SourceTime",
      "type": "object"
    },
    "TextCell": {
      "additionalProperties": false,
      "description": "A text cell; ``value`` is what a click on the column header sorts by. ``source`` is a label\nshown in a Badge beside the text (the urgent mark); ``badge`` shows the text itself in a Badge.",
      "properties": {
        "badge": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Badge"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "text",
        "value"
      ],
      "title": "TextCell",
      "type": "object"
    }
  },
  "$id": "https://option-trader.invalid/schemas/advice_page.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Build Id",
      "type": "string"
    },
    "data_times": {
      "items": {
        "$ref": "#/$defs/SourceTime"
      },
      "maxItems": 20,
      "title": "Data Times",
      "type": "array"
    },
    "day": {
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$",
      "title": "Day",
      "type": "string"
    },
    "gap": {
      "anyOf": [
        {
          "$ref": "#/$defs/Gap"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generated_at": {
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
      "title": "Generated At",
      "type": "string",
      "x-timezone": "owner"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/AdviceRow"
      },
      "maxItems": 500,
      "title": "Rows",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "schema": {
      "const": "advice_page",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Scope",
      "type": "string"
    },
    "sentence": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Sentence",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "title",
    "sentence",
    "day",
    "rows"
  ],
  "title": "AdvicePage",
  "type": "object"
}
