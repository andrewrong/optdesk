{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optdesk.invalid/schemas/page.core_page.v1.json",
  "title": "CorePage",
  "description": "Board 15: core. The page gives no target price and feeds no rule.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "stale",
    "title",
    "sentence",
    "notes",
    "gaps",
    "basis_note",
    "scale",
    "rows",
    "jp_note",
    "legend",
    "snapshot_text"
  ],
  "properties": {
    "schema": {
      "const": "core_page",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "run_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "build_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "scope": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "generated_at": {
      "$ref": "common.v2.json#/$defs/Timestamp"
    },
    "data_times": {
      "type": "array",
      "items": {
        "$ref": "common.v2.json#/$defs/SourceTime"
      }
    },
    "run_status": {
      "$ref": "common.v2.json#/$defs/RunStatus"
    },
    "stale": {
      "oneOf": [
        {
          "$ref": "common.v2.json#/$defs/StaleLabel"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "$ref": "#/$defs/Text"
    },
    "sentence": {
      "$ref": "#/$defs/Text"
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Text"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "common.v2.json#/$defs/Gap"
      }
    },
    "basis_note": {
      "$ref": "#/$defs/Text"
    },
    "scale": {
      "$ref": "#/$defs/Scale"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CoreRow"
      }
    },
    "jp_note": {
      "$ref": "#/$defs/Text"
    },
    "legend": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Text"
      }
    },
    "snapshot_text": {
      "$ref": "#/$defs/Text"
    },
    "stale_after": {
      "$ref": "common.v2.json#/$defs/Timestamp"
    }
  },
  "$defs": {
    "CoreRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "$ref": "#/$defs/Text"
        },
        "price_text": {
          "$ref": "#/$defs/Text"
        },
        "cyclical": {
          "type": "boolean"
        },
        "flag": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "returns": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ReturnPoint"
              },
              "minItems": 1,
              "maxItems": 6
            },
            {
              "$ref": "common.v2.json#/$defs/Gap"
            }
          ]
        }
      },
      "required": [
        "symbol",
        "price_text",
        "cyclical",
        "flag",
        "returns"
      ]
    },
    "Figure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "value",
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "text": {
          "$ref": "#/$defs/Text"
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "required": [
        "kind",
        "value",
        "text",
        "unit"
      ],
      "description": "A number the producer wrote; the view prints text."
    },
    "FigureOrGap": {
      "oneOf": [
        {
          "$ref": "#/$defs/Figure"
        },
        {
          "$ref": "common.v2.json#/$defs/Gap"
        }
      ]
    },
    "ReturnPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assumption": {
          "$ref": "#/$defs/Text"
        },
        "text": {
          "$ref": "#/$defs/Text"
        },
        "marker_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Position of the dot on the bar, 0 to 100 (metric id: assigned by compute)",
          "x-decimals": 1
        }
      },
      "required": [
        "assumption",
        "text",
        "marker_percent"
      ],
      "description": "Return at today's price under one assumption; the text is produced."
    },
    "Scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "low_text": {
          "$ref": "#/$defs/Text"
        },
        "high_text": {
          "$ref": "#/$defs/Text"
        },
        "treasury": {
          "$ref": "#/$defs/Treasury"
        }
      },
      "required": [
        "low_text",
        "high_text",
        "treasury"
      ]
    },
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "Treasury": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/$defs/Text"
        },
        "marker_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Position of the treasury mark on the bar, 0 to 100 (metric id: assigned by compute)",
          "x-decimals": 1
        }
      },
      "required": [
        "text",
        "marker_percent"
      ]
    }
  }
}
