            }
          ],
          "default": null,
          "title": "Explain"
        },
        "figure": {
          "anyOf": [
            {
              "$ref": "common.v1.json#/$defs/UsdSignedFigure"
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ],
          "title": "Figure"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "figure",
        "caption"
      ],
      "title": "DayChangeTile",
      "type": "object"
