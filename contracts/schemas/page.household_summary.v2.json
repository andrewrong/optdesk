  "$id": "https://optdesk.invalid/schemas/page.household_summary.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Envelope (ADR 0034) and card.",
  "properties": {
    "build_id": {
      "$ref": "common.v1.json#/$defs/Id"
    },
    "card": {
      "$ref": "#/$defs/Card"
    },
    "currency": {
      "const": "USD",
      "title": "Currency",
      "type": "string"
    },
    "data_times": {
      "items": {
        "$ref": "common.v1.json#/$defs/SourceTime"
      },
      "maxItems": 20,
      "title": "Data Times",
      "type": "array"
    },
    "generated_at": {
      "$ref": "common.v1.json#/$defs/Timestamp"
    },
    "run_id": {
      "$ref": "common.v1.json#/$defs/Id"
    },
    "run_status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "schema": {
      "const": "household_summary",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "common.v1.json#/$defs/Id"
    },
    "stale_after": {
      "$ref": "common.v1.json#/$defs/Timestamp"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "currency",
    "generated_at",
    "data_times",
    "run_status",
    "card"
  ],
  "title": "HouseholdSummary",
  "type": "object"
}
