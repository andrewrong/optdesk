    "MonthToDateTile": {
      "additionalProperties": false,
      "properties": {
        "caption": {
          "anyOf": [
            {
              "$ref": "common.v1.json#/$defs/PercentFigure"
            },
            {
              "$ref": "#/$defs/Caption"
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ],
          "title": "Caption"
        },
        "explain": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
