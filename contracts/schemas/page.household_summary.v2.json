    "Tiles": {
      "additionalProperties": false,
      "description": "The four tiles, under fixed keys.",
      "properties": {
        "cash": {
          "$ref": "#/$defs/CashTile"
        },
        "day_change": {
          "$ref": "#/$defs/DayChangeTile"
        },
        "month_to_date": {
