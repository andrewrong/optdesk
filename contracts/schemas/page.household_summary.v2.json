{
  "$defs": {
    "Caption": {
      "additionalProperties": false,
      "description": "A plain small line under a figure.",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Caption",
      "type": "object"
    },
    "Card": {
      "additionalProperties": false,
      "properties": {
        "data_times_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Data Times Text",
          "type": "string"
        },
        "gaps": {
          "items": {
            "$ref": "common.v1.json#/$defs/Gap"
          },
          "maxItems": 20,
          "title": "Gaps",
          "type": "array"
        },
        "notes": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Notes",
          "type": "array"
        },
        "stale": {
          "$ref": "common.v1.json#/$defs/StaleLabel"
        },
        "subtitle": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Subtitle",
          "type": "string"
        },
        "tiles": {
          "$ref": "#/$defs/Tiles"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "subtitle",
        "stale",
        "tiles",
        "notes",
        "gaps",
        "data_times_text"
      ],
      "title": "Card",
      "type": "object"
    },
    "CashTile": {
      "additionalProperties": false,
      "properties": {
        "caption": {
          "anyOf": [
            {
              "$ref": "common.v1.json#/$defs/UsdSignedFigure"
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ],
          "title": "Caption"
        },
        "explain": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explain"
        },
        "figure": {
          "anyOf": [
            {
              "$ref": "common.v1.json#/$defs/SharePercentFigure"
            },
            {
              "$ref": "#/$defs/Caption"
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ],
          "title": "Figure"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "figure",
        "caption"
      ],
      "title": "CashTile",
      "type": "object"
    },
