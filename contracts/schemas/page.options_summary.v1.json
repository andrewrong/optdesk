{
  "$defs": {
    "Card": {
      "additionalProperties": false,
      "properties": {
        "gaps": {
          "items": {
            "$ref": "#/$defs/Gap"
          },
          "maxItems": 20,
          "title": "Gaps",
          "type": "array"
        },
        "notes": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Notes",
          "type": "array"
        },
        "premium_series_6m": {
          "items": {
            "$ref": "#/$defs/SeriesPoint"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Premium Series 6M",
          "type": "array"
        },
        "premium_series_caption": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Premium Series Caption",
          "type": "string"
        },
        "premium_series_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Premium Series Text",
          "type": "string"
        },
        "say": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Say"
        },
        "stale": {
          "$ref": "#/$defs/StaleLabel"
        },
        "subtitle": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Subtitle",
          "type": "string"
        },
        "tiles": {
          "$ref": "#/$defs/Tiles"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "subtitle",
        "stale",
        "tiles",
        "premium_series_6m",
        "premium_series_text",
        "premium_series_caption",
        "notes",
        "gaps"
      ],
      "title": "Card",
      "type": "object"
    },
    "CountFigure": {
      "additionalProperties": false,
      "description": "A displayed count of option structures (a short put, a spread: one structure each).",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "structures",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Value",
          "type": "integer",
          "x-decimals": 0
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "CountFigure",
      "type": "object"
    },
    "CountTile": {
      "additionalProperties": false,
      "properties": {
        "caption": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "figure": {
          "anyOf": [
            {
              "$ref": "#/$defs/CountFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Figure"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "figure"
      ],
      "title": "CountTile",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "description": "A named data gap, used in place of a figure that cannot be computed. Never a zero.",
      "properties": {
        "reason": {
          "enum": [
            "missing_quote",
            "no_data",
            "unsupported_currency"
          ],
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "text"
      ],
      "title": "Gap",
      "type": "object"
    },
    "SeriesPoint": {
      "additionalProperties": false,
      "properties": {
        "closed": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdSignedFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Closed"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "month": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "title": "Month",
          "type": "string"
        },
        "premium": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdSignedFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Premium"
        }
      },
      "required": [
        "month",
        "premium",
        "label",
        "closed"
      ],
      "title": "SeriesPoint",
      "type": "object"
    },
    "SignedUsdTile": {
      "additionalProperties": false,
      "properties": {
        "caption": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "figure": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdSignedFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Figure"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "figure"
      ],
      "title": "SignedUsdTile",
      "type": "object"
    },
    "SourceTime": {
      "additionalProperties": false,
      "description": "The data time of one source behind the card.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "source": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "data_time"
      ],
      "title": "SourceTime",
      "type": "object"
    },
    "StaleLabel": {
      "additionalProperties": false,
      "description": "Python sends the times and the label; the browser only compares its clock with ``stale_after``.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "stale_after": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Stale After",
          "type": "string",
          "x-timezone": "owner"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "data_time",
        "stale_after",
        "text"
      ],
      "title": "StaleLabel",
      "type": "object"
    },
    "Tiles": {
      "additionalProperties": false,
      "description": "The four tiles, under fixed keys.",
      "properties": {
        "max_loss_usd": {
          "$ref": "#/$defs/UsdTile"
        },
        "open_premium_usd": {
          "$ref": "#/$defs/UsdTile"
        },
        "premium_month_usd": {
          "$ref": "#/$defs/SignedUsdTile"
        },
        "sold_count_month": {
          "$ref": "#/$defs/CountTile"
        }
      },
      "required": [
        "sold_count_month",
        "premium_month_usd",
        "open_premium_usd",
        "max_loss_usd"
      ],
      "title": "Tiles",
      "type": "object"
    },
    "UsdFigure": {
      "additionalProperties": false,
      "description": "A displayed US-dollar amount (two decimals in ``value``, whole dollars in ``text``).",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "USD",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000.0,
          "minimum": 0,
          "multipleOf": 0.01,
          "title": "Value",
          "type": "number",
          "x-decimals": 2,
          "x-rounding": "ROUND_HALF_UP"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "UsdFigure",
      "type": "object"
    },
    "UsdSignedFigure": {
      "additionalProperties": false,
      "description": "A signed US-dollar amount; ``text`` starts with ``+`` or ``−`` (U+2212).",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "anyOf": [
            {
              "enum": [
                "up",
                "down",
                "flat",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tone"
        },
        "unit": {
          "const": "usd_signed",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "multipleOf": 0.01,
          "title": "Value",
          "type": "number",
          "x-decimals": 2,
          "x-rounding": "ROUND_HALF_UP"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "UsdSignedFigure",
      "type": "object"
    },
    "UsdTile": {
      "additionalProperties": false,
      "properties": {
        "caption": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "figure": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Figure"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "figure"
      ],
      "title": "UsdTile",
      "type": "object"
    }
  },
  "$id": "https://option-trader.invalid/schemas/options_summary.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Envelope (ADR 0034) and card.",
  "properties": {
    "build_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Build Id",
      "type": "string"
    },
    "card": {
      "$ref": "#/$defs/Card"
    },
    "currency": {
      "const": "USD",
      "title": "Currency",
      "type": "string"
    },
    "data_times": {
      "items": {
        "$ref": "#/$defs/SourceTime"
      },
      "maxItems": 20,
      "title": "Data Times",
      "type": "array"
    },
    "generated_at": {
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
      "title": "Generated At",
      "type": "string",
      "x-timezone": "owner"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "schema": {
      "const": "options_summary",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "currency",
    "generated_at",
    "data_times",
    "run_status",
    "card"
  ],
  "title": "OptionsSummary",
  "type": "object"
}
