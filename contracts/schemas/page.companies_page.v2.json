{
  "$defs": {
    "Cell": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "default": "none",
          "enum": [
            "up",
            "down",
            "flat",
            "none"
          ],
          "title": "Tone",
          "type": "string"
        },
        "price_state": {
          "enum": [
            "band",
            "owner override",
            "awaiting approval",
            "expired"
          ],
          "type": "string",
          "description": "The state of a price line cell: the band, the owner's own price, the band not yet approved, or the approval older than 90 days."
        },
        "hand_price": {
          "$ref": "#/$defs/Text",
          "description": "The owner's hand-entered buy price as text, shown beside the band; never changed."
        }
      },
      "required": [
        "text"
      ],
      "title": "Cell",
      "type": "object",
      "description": "A table cell. A price line cell may carry price_state and hand_price."
    },
    "ChangesBlock": {
      "additionalProperties": false,
      "description": "``lines`` are the changes; ``sentence`` is the one state sentence (近 7 天没有变化, or the\nreading is not usable); ``note`` is ``数据日 月-日`` when the reading is of an earlier day.",
      "properties": {
        "lines": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Lines",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "sentence": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentence"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "lines"
      ],
      "title": "ChangesBlock",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "description": "A column head; ``numeric`` columns are right-aligned by the browser.",
      "properties": {
        "numeric": {
          "title": "Numeric",
          "type": "boolean"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "numeric"
      ],
      "title": "Column",
      "type": "object"
    },
    "CoreBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis_note": {
          "$ref": "#/$defs/Text"
        },
        "low_text": {
          "$ref": "#/$defs/Text"
        },
        "high_text": {
          "$ref": "#/$defs/Text"
        },
        "treasury": {
          "anyOf": [
            {
              "$ref": "#/$defs/Treasury"
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ],
          "description": "The newest DGS10 point within 7 days of today, or a Gap."
        },
        "jp_rate": {
          "anyOf": [
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ],
          "description": "A Japanese name has no rate to compare with: always a Gap."
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoreRow"
          },
          "maxItems": 200
        },
        "legend": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "maxItems": 20
        },
        "snapshot_text": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "basis_note",
        "low_text",
        "high_text",
        "treasury",
        "jp_rate",
        "rows",
        "legend",
        "snapshot_text"
      ]
    },
    "CoreRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "$ref": "#/$defs/Text"
        },
        "price_text": {
          "$ref": "#/$defs/Text"
        },
        "cyclical": {
          "type": "boolean"
        },
        "flag": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "returns": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ReturnPoint"
              },
              "minItems": 1,
              "maxItems": 6
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ]
        }
      },
      "required": [
        "symbol",
        "price_text",
        "cyclical",
        "flag",
        "returns"
      ],
      "description": "One company at one cost (the bare strike of a shown offer): the returns at that cost, no rank and no verdict."
    },
    "Day": {
      "type": "string",
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$"
    },
    "DiagGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Class named by the producer; the view orders groups by array position."
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "maxItems": 12
        },
        "rows": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/DiagRow"
              },
              {
                "$ref": "common.v1.json#/$defs/Gap"
              }
            ]
          },
          "maxItems": 200
        },
        "legend": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "maxItems": 20
        }
      },
      "required": [
        "key",
        "title",
        "columns",
        "rows",
        "legend"
      ]
    },
    "DiagRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "$ref": "#/$defs/Text"
        },
        "latest_fy": {
          "$ref": "#/$defs/Text"
        },
        "latest": {
          "$ref": "#/$defs/Text"
        },
        "rank_text": {
          "$ref": "#/$defs/Text"
        },
        "extra": {
          "$ref": "#/$defs/Text"
        },
        "usual": {
          "$ref": "#/$defs/Text"
        },
        "years": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/YearRow"
          },
          "maxItems": 12
        }
      },
      "required": [
        "symbol",
        "latest_fy",
        "latest",
        "rank_text",
        "extra",
        "usual",
        "years"
      ],
      "description": "Ten-year ratios and ranks as produced text (metric id: assigned by compute)."
    },
    "DiagnosisBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis_note": {
          "$ref": "#/$defs/Text"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiagGroup"
          },
          "maxItems": 10
        }
      },
      "required": [
        "basis_note",
        "groups"
      ]
    },
    "Figure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "text": {
          "$ref": "#/$defs/Text"
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "description": "A number the producer wrote; the view prints text."
    },
    "GlanceBlock": {
      "additionalProperties": false,
      "description": "``note`` is the price-lines state sentence, present only when the lines are not usable.",
      "properties": {
        "note": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "tiles": {
          "items": {
            "$ref": "#/$defs/Tile"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Tiles",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "tiles"
      ],
      "title": "GlanceBlock",
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "description": "``line`` is ``月-日 · 家庭持有 N 家``; ``held_count`` is N, None without a held reading.",
      "properties": {
        "data_day": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)$",
          "title": "Data Day",
          "type": "string"
        },
        "held_count": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Held Count"
        },
        "line": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "data_day"
      ],
      "title": "Header",
      "type": "object"
    },
    "HoldingRow": {
      "additionalProperties": false,
      "description": "One held company: a cell per column, and its moat lines (the owner's record as written, or\n``护城河记录未填``).",
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Cells",
          "type": "array"
        },
        "moat": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Moat",
          "type": "array"
        }
      },
      "required": [
        "cells",
        "moat"
      ],
      "title": "HoldingRow",
      "type": "object"
    },
    "HoldingsBlock": {
      "additionalProperties": false,
      "description": "``volatility_note`` is the label line of the 波动 column (the own series and the data day);\nabsent on a payload made before the column.",
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/HoldingRow"
          },
          "maxItems": 200,
          "title": "Rows",
          "type": "array"
        },
        "volatility_note": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volatility Note"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "HoldingsBlock",
      "type": "object"
    },
    "PepbAtPercentile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "percentile": {
          "type": "integer",
          "enum": [
            20,
            50
          ]
        },
        "ratio": {
          "allOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "type": "object",
              "properties": {
                "unit": {
                  "const": "ratio"
                }
              }
            }
          ]
        },
        "price": {
          "allOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "type": "object",
              "properties": {
                "unit": {
                  "const": "price"
                }
              }
            }
          ]
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "percentile",
        "ratio",
        "price",
        "text"
      ],
      "description": "The ratio at a rank of the window and the price that puts today's ratio there; history, not a buy price."
    },
    "PepbBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis_note": {
          "$ref": "#/$defs/Text"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PepbRow"
          },
          "maxItems": 200
        }
      },
      "required": [
        "basis_note",
        "rows"
      ]
    },
    "PepbHistoryPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day": {
          "$ref": "#/$defs/Day"
        },
        "value": {
          "type": "number"
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "day",
        "value",
        "text"
      ],
      "description": "One stored day of the chart."
    },
    "PepbLine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/$defs/Text"
        },
        "ratio": {
          "allOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "type": "object",
              "properties": {
                "unit": {
                  "const": "ratio"
                }
              }
            }
          ]
        },
        "day": {
          "$ref": "#/$defs/Day"
        },
        "basis_end": {
          "$ref": "#/$defs/Day"
        },
        "percentile": {
          "anyOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ]
        },
        "at_percentile": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PepbAtPercentile"
          },
          "maxItems": 2
        },
        "shares": {
          "$ref": "#/$defs/Text"
        },
        "shares_filed": {
          "$ref": "#/$defs/Day"
        },
        "window_days": {
          "type": "integer",
          "minimum": 0
        },
        "window_from": {
          "$ref": "#/$defs/Day"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PepbHistoryPoint"
          },
          "maxItems": 120
        }
      },
      "required": [
        "text",
        "ratio",
        "day",
        "basis_end",
        "percentile",
        "at_percentile",
        "shares",
        "shares_filed",
        "window_days",
        "window_from",
        "history"
      ],
      "description": "One ratio of one company on the newest stored day, as produced text and figures; no verdict."
    },
    "PepbRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "$ref": "#/$defs/Text"
        },
        "pe": {
          "anyOf": [
            {
              "$ref": "#/$defs/PepbLine"
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ]
        },
        "pb": {
          "anyOf": [
            {
              "$ref": "#/$defs/PepbLine"
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ]
        },
        "forward": {
          "allOf": [
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ],
          "description": "Forward PE has no estimates source: always a Gap."
        }
      },
      "required": [
        "symbol",
        "pe",
        "pb",
        "forward"
      ],
      "description": "One company: PE and PB each a line or a Gap, and the forward Gap."
    },
    "QuestionRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "$ref": "#/$defs/Text"
        },
        "q1": {
          "anyOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ],
          "description": "Return on tangible capital."
        },
        "q2": {
          "anyOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ],
          "description": "Growth cost."
        },
        "q3": {
          "anyOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ],
          "description": "Pricing power."
        },
        "q4": {
          "anyOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ],
          "description": "Cash behind profit."
        },
        "fifth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "$ref": "common.v1.json#/$defs/Gap"
            }
          ],
          "description": "The owner's own text for the fifth question, or a Gap when none is entered."
        }
      },
      "required": [
        "symbol",
        "q1",
        "q2",
        "q3",
        "q4",
        "fifth"
      ],
      "description": "Q1 to Q4 as figures from filings or a Gap; Q5 has no figure."
    },
    "QuestionsBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis_note": {
          "$ref": "#/$defs/Text"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionRow"
          },
          "maxItems": 200
        }
      },
      "required": [
        "basis_note",
        "rows"
      ]
    },
    "ReturnPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assumption": {
          "$ref": "#/$defs/Text"
        },
        "text": {
          "$ref": "#/$defs/Text"
        },
        "marker_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Position of the dot on the bar, 0 to 100 (metric id: assigned by compute)",
          "x-decimals": 1
        }
      },
      "required": [
        "assumption",
        "text",
        "marker_percent"
      ],
      "description": "Return at the cost under one assumption; the text is produced."
    },
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "Tile": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "label",
        "text"
      ],
      "title": "Tile",
      "type": "object"
    },
    "Treasury": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/$defs/Text"
        },
        "marker_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Position of the treasury mark on the bar, 0 to 100 (metric id: assigned by compute)",
          "x-decimals": 1
        }
      },
      "required": [
        "text",
        "marker_percent"
      ]
    },
    "WatchBlock": {
      "additionalProperties": false,
      "description": "Rows, or one state sentence naming the file (not filled / unreadable) and no rows.",
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "maxItems": 12,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/WatchRow"
          },
          "maxItems": 200,
          "title": "Rows",
          "type": "array"
        },
        "sentence": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentence"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "columns",
        "rows"
      ],
      "title": "WatchBlock",
      "type": "object"
    },
    "WatchRow": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Cells",
          "type": "array"
        }
      },
      "required": [
        "cells"
      ],
      "title": "WatchRow",
      "type": "object"
    },
    "YearRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fy": {
          "$ref": "#/$defs/Text"
        },
        "revenue": {
          "$ref": "#/$defs/Text"
        },
        "margin": {
          "$ref": "#/$defs/Text"
        },
        "extra": {
          "$ref": "#/$defs/Text"
        },
