    "MoneyCell": {
      "additionalProperties": false,
      "description": "A money cell with a currency and, for JPY, an optional display-only ``approx_usd``.",
      "properties": {
        "approx_usd": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdFigure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "currency": {
          "enum": [
            "USD",
            "JPY"
          ],
          "title": "Currency",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "anyOf": [
            {
              "enum": [
                "up",
                "down",
                "flat",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tone"
        },
        "unit": {
          "enum": [
            "usd",
            "usd_per_share",
            "usd_signed"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": -1000000000,
          "multipleOf": 0.01,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "text",
        "unit",
        "currency"
      ],
      "title": "MoneyCell",
      "type": "object"
    },
