        "value": {
          "maximum": 1000000000.0,
          "minimum": 0,
          "multipleOf": 0.01,
          "title": "Value",
          "type": "number",
          "x-decimals": 2,
          "x-rounding": "ROUND_HALF_UP"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "UsdFigure",
      "type": "object"
    },
