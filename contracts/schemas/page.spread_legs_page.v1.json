{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optdesk.invalid/schemas/page.spread_legs_page.v1.json",
  "title": "SpreadLegsPage",
  "description": "The spreads the account holds, each as one strategy with its legs, net credit, max loss, max gain and break-evens, then the units the matcher could not name. A render of text a producer wrote; nothing is computed here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "title",
    "sentence",
    "note",
    "groups",
    "stale"
  ],
  "properties": {
    "schema": {
      "const": "spread_legs_page",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "run_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "build_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "scope": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "generated_at": {
      "$ref": "common.v2.json#/$defs/Timestamp"
    },
    "data_times": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "common.v2.json#/$defs/SourceTime"
      }
    },
    "run_status": {
      "$ref": "common.v2.json#/$defs/RunStatus"
    },
    "stale": {
      "$ref": "common.v2.json#/$defs/StaleLabel"
    },
    "title": {
      "$ref": "#/$defs/Text"
    },
    "sentence": {
      "$ref": "#/$defs/Text"
    },
    "note": {
      "oneOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ]
    },
    "groups": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/Group"
      }
    }
  },
  "$defs": {
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "Group": {
      "description": "One card of the page: its title and its structures in order (the spreads first, the unidentified units second).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "structures"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/Text"
        },
        "structures": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/Structure"
          }
        }
      }
    },
    "Structure": {
      "description": "One structure with its legs. ``href`` is the detail route of the same structure. ``reason`` is the line of an unidentified unit, null otherwise.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "href",
        "kind_text",
        "kind_gloss",
        "expiry_text",
        "legs",
        "net_credit",
        "max_loss",
        "max_gain",
        "break_even",
        "reason"
      ],
      "properties": {
        "symbol": {
          "$ref": "#/$defs/Text"
        },
        "href": {
          "type": "string",
          "pattern": "^/(structure/[A-Za-z0-9_-]{1,64}|options/structures/[A-Za-z0-9_.~%:-]{1,200})$"
        },
        "kind_text": {
          "$ref": "#/$defs/Text"
        },
        "kind_gloss": {
          "$ref": "#/$defs/Text"
        },
        "expiry_text": {
          "$ref": "#/$defs/Text"
        },
        "legs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/Leg"
          }
        },
        "net_credit": {
          "$ref": "#/$defs/Cell"
        },
        "max_loss": {
          "$ref": "#/$defs/Cell"
        },
        "max_gain": {
          "$ref": "#/$defs/Cell"
        },
        "break_even": {
          "$ref": "#/$defs/BreakEven"
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Leg": {
      "description": "One leg as ready texts.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side_text",
        "strike",
        "expiry_text",
        "quantity",
        "open_price"
      ],
      "properties": {
        "side_text": {
          "$ref": "#/$defs/Text"
        },
        "strike": {
          "$ref": "#/$defs/Text"
        },
        "expiry_text": {
          "$ref": "#/$defs/Text"
        },
        "quantity": {
          "$ref": "#/$defs/Text"
        },
        "open_price": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "Cell": {
      "description": "A figure as a number with its text, or a gap with its reason in words. Never a zero for a missing figure.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "enum": [
            "value",
            "gap"
          ],
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/Text"
        },
        "value": {
          "type": "number",
          "minimum": -1000000000000,
          "maximum": 1000000000000
        },
        "unit": {
          "$ref": "#/$defs/Text"
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "gap"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "unit"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "value",
              "unit"
            ],
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        }
      ]
    },
    "BreakEven": {
      "description": "Every break-even price, ascending, or a gap with its reason in words. ``values`` is empty for a gap.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "values"
      ],
      "properties": {
        "kind": {
          "enum": [
            "values",
            "gap"
          ],
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/Text"
        },
        "values": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "number",
            "minimum": -1000000000000,
            "maximum": 1000000000000
          }
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "gap"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "values": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            },
            "properties": {
              "values": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
