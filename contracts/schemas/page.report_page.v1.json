  "$id": "https://option-trader.invalid/schemas/report_page.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "banner": {
      "$ref": "#/$defs/Banner"
    },
    "blocks": {
      "$ref": "#/$defs/Blocks"
    },
    "chips": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Chip"
          },
          "maxItems": 6,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chips"
    },
    "design_note": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Design Note"
    },
    "generated_at": {
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
      "title": "Generated At",
      "type": "string",
      "x-timezone": "owner"
    },
    "market": {
      "enum": [
        "US",
        "JP"
      ],
      "title": "Market",
      "type": "string"
    },
    "say": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Say",
      "type": "string"
    },
    "schema": {
      "const": "report_page",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_date": {
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "title": "Session Date",
      "type": "string"
    },
    "slot": {
      "enum": [
        "open",
        "close"
      ],
      "title": "Slot",
      "type": "string"
    },
    "stale": {
      "anyOf": [
        {
          "$ref": "#/$defs/StaleLabel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status_lines": {
      "items": {
        "$ref": "#/$defs/StatusLine"
      },
      "maxItems": 20,
      "title": "Status Lines",
      "type": "array"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "market",
    "slot",
    "session_date",
    "generated_at",
    "title",
    "say",
    "banner",
    "status_lines",
    "blocks"
  ],
  "title": "ReportPage",
  "type": "object"
}
