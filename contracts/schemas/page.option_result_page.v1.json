{
  "$defs": {
    "Pair": {
      "additionalProperties": false,
      "description": "A term and its value, both text as Python wrote them.",
      "properties": {
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "Pair",
      "type": "object"
    },
    "Reliability": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "key": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Key",
          "type": "string"
        },
        "lines": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Lines",
          "type": "array"
        }
      },
      "required": [
        "key",
        "heading",
        "lines"
      ],
      "title": "Reliability",
      "type": "object"
    },
    "ResultSection": {
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Assignment"
        },
        "books_lines": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Books Lines",
          "type": "array"
        },
        "books_note": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Books Note",
          "type": "string"
        },
        "books_title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Books Title",
          "type": "string"
        },
        "endings": {
          "$ref": "#/$defs/Series"
        },
        "endings_lines": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Endings Lines",
          "type": "array"
        },
        "endings_title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Endings Title",
          "type": "string"
        },
        "figure_notes": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "title": "Figure Notes",
          "type": "array"
        },
        "figures": {
          "items": {
            "$ref": "#/$defs/Pair"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Figures",
          "type": "array"
        },
        "heading": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "key": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Key",
          "type": "string"
        },
        "lead": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Lead",
          "type": "string"
        },
        "months": {
          "$ref": "#/$defs/Series"
        },
        "protection": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Protection"
        },
        "running": {
          "$ref": "#/$defs/Series"
        },
        "scope": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "key",
        "heading",
        "lead",
        "scope",
        "figures",
        "figure_notes",
        "months",
        "running",
        "endings_title",
        "endings_lines",
        "endings",
        "assignment",
        "protection",
        "books_title",
        "books_note",
        "books_lines"
      ],
      "title": "ResultSection",
      "type": "object"
    },
    "Series": {
      "additionalProperties": false,
      "description": "A chart's title and points. ``summary`` is the points' ``{label} {text}`` joined by ``；``, the\ntext that stands for the chart (its ARIA text); ``empty`` is the sentence that stands in when\nthere is no point (then ``summary`` is absent).",
      "properties": {
        "empty": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Empty"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/SeriesPoint"
          },
          "maxItems": 600,
          "title": "Points",
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Summary"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "points",
        "summary",
        "empty"
      ],
      "title": "Series",
      "type": "object"
    },
    "SeriesPoint": {
      "additionalProperties": false,
      "description": "One month or one ending: the axis label, the number the chart draws, the text shown and\nwhether the point is muted (a month that is not over).",
      "properties": {
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "muted": {
          "title": "Muted",
          "type": "boolean"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "label",
        "value",
        "text",
        "muted"
      ],
      "title": "SeriesPoint",
      "type": "object"
    },
    "SourceTime": {
      "additionalProperties": false,
      "description": "The data time of one source behind the card.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "source": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "data_time"
      ],
      "title": "SourceTime",
      "type": "object"
    },
    "StaleLabel": {
      "additionalProperties": false,
      "description": "Python sends the times and the label; the browser only compares its clock with ``stale_after``.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "stale_after": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Stale After",
          "type": "string",
          "x-timezone": "owner"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "data_time",
        "stale_after",
        "text"
      ],
      "title": "StaleLabel",
      "type": "object"
    }
  },
  "$id": "https://option-trader.invalid/schemas/option_result_page.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Build Id",
      "type": "string"
    },
    "data_times": {
      "items": {
        "$ref": "#/$defs/SourceTime"
      },
      "maxItems": 20,
      "title": "Data Times",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Pair"
      },
      "maxItems": 10,
      "title": "Facts",
      "type": "array"
    },
    "generated_at": {
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
      "title": "Generated At",
      "type": "string",
      "x-timezone": "owner"
    },
    "notes": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Notes",
      "type": "array"
    },
    "nothing": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Nothing"
    },
    "reliability": {
      "items": {
        "$ref": "#/$defs/Reliability"
      },
      "maxItems": 50,
      "title": "Reliability",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "schema": {
      "const": "option_result_page",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Scope",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ResultSection"
      },
      "maxItems": 100,
      "title": "Sections",
      "type": "array"
    },
    "stale": {
      "anyOf": [
        {
          "$ref": "#/$defs/StaleLabel"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "title",
    "stale",
    "nothing",
    "sections",
    "reliability",
    "facts",
    "notes"
  ],
  "title": "OptionResultPage",
  "type": "object"
}
