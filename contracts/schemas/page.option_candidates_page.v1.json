{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optdesk.invalid/schemas/page.option_candidates_page.v1.json",
  "title": "OptionCandidatesPage",
  "description": "The option candidates page: the stored short puts, covered calls and guard rows of the last run. A render of rows a producer writes; nothing is computed here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "stale",
    "title",
    "notes",
    "gaps",
    "chain_day",
    "computed_at",
    "rule_version",
    "estimate_note",
    "groups"
  ],
  "properties": {
    "schema": {
      "const": "option_candidates_page",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "run_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "build_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "scope": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "generated_at": {
      "$ref": "common.v2.json#/$defs/Timestamp"
    },
    "data_times": {
      "type": "array",
      "items": {
        "$ref": "common.v2.json#/$defs/SourceTime"
      }
    },
    "run_status": {
      "$ref": "common.v2.json#/$defs/RunStatus"
    },
    "stale": {
      "oneOf": [
        {
          "$ref": "common.v2.json#/$defs/StaleLabel"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "$ref": "#/$defs/Text"
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Text"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Gap"
      }
    },
    "chain_day": {
      "description": "Date text of the option chain day, or null.",
      "oneOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ]
    },
    "computed_at": {
      "description": "Time the run was computed, text in the owner zone, or null.",
      "oneOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ]
    },
    "rule_version": {
      "oneOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ]
    },
    "estimate_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "groups": {
      "description": "One to three groups in the order short_put, covered_call, held_call_guard.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/Group"
      }
    },
    "stale_after": {
      "$ref": "common.v2.json#/$defs/Timestamp"
    },
    "short_put_tiers": {
      "description": "The tier view of the stored short puts, or null. Additive and optional; every figure is text.",
      "oneOf": [
        {
          "$ref": "#/$defs/TierView"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "Group": {
      "description": "One kind of candidate. gap is non-null exactly when main and other are both null.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "day",
        "stale",
        "counts",
        "main",
        "other",
        "gap"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "short_put",
            "covered_call",
            "held_call_guard"
          ]
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "day": {
          "description": "Date text of the rows of this group, or null.",
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "description": "True when day is before the build day.",
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/$defs/Counts"
        },
        "main": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Table"
            }
          ]
        },
        "other": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Table"
            }
          ]
        },
        "gap": {
          "oneOf": [
            {
              "$ref": "#/$defs/Gap"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "main": {
                  "type": "null"
                },
                "other": {
                  "type": "null"
                },
                "gap": {
                  "$ref": "#/$defs/Gap"
                }
              }
            },
            {
              "properties": {
                "gap": {
                  "type": "null"
                }
              },
              "anyOf": [
                {
                  "properties": {
                    "main": {
                      "$ref": "#/$defs/Table"
                    }
                  }
                },
                {
                  "properties": {
                    "other": {
                      "$ref": "#/$defs/Table"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "Counts": {
      "description": "The stored row counts of the group.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "blocked",
        "unknown"
      ],
      "properties": {
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "rows"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Row"
          }
        }
      }
    },
    "Column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "align",
        "hint"
      ],
      "properties": {
        "id": {
          "$ref": "common.v2.json#/$defs/Id"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "hint": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cells",
        "reasons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cand-[A-Za-z0-9_-]{1,64}$"
        },
        "cells": {
          "description": "Column id to Cell.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Cell"
          }
        },
        "reasons": {
          "description": "Only on other rows; empty on main rows.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reason"
          }
        }
      }
    },
    "Cell": {
      "oneOf": [
        {
          "$ref": "#/$defs/ValueCell"
        },
        {
          "$ref": "#/$defs/Gap"
        }
      ]
    },
    "ValueCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "value",
        "badges",
        "tone"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 200
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "badges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          }
        },
        "tone": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "flat",
            "none"
          ]
        }
      }
    },
    "Reason": {
      "description": "Why a row is blocked or unknown. gate and code are patterns, not enums, so a new gate needs no schema change.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "status",
        "code",
        "text"
      ],
      "properties": {
        "gate": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "block",
            "unknown"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z_]{1,48}$"
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "Gap": {
      "description": "A named data gap, used in place of a value that cannot be shown. Never a zero. The reasons of common.v2 plus no_rows (a group without rows in its lookback), no_run (no stored run) and unreadable (a stored value that cannot be shown).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "gap",
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "missing_quote",
            "no_data",
            "unsupported_currency",
            "not_built",
            "no_reader",
            "no_news_source",
            "no_rule",
            "market_closed",
            "stale",
            "flex_time_unknown",
            "jp_slice_missing",
            "missing_input",
            "stale_input",
            "no_rows",
            "no_run",
            "unreadable"
          ]
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "TierView": {
      "description": "The short puts sorted into tiers, from docs/design/candidates-tiers.md#Interface.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_day",
        "companies",
        "common",
        "kept",
        "legend",
        "columns",
        "tiers"
      ],
      "properties": {
        "chain_day": {
          "$ref": "#/$defs/Text"
        },
        "companies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Company"
          }
        },
        "common": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mark"
          }
        },
        "kept": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "kept_note": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_title": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "legend": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LegendItem"
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TierColumn"
          }
        },
        "tiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tier"
          }
        }
      }
    },
    "Company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "ticker",
        "spot",
        "spot_day",
        "buy_price",
        "buy_price_note",
        "next_earnings",
        "counts"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/Text"
        },
        "ticker": {
          "$ref": "#/$defs/Text"
        },
        "spot": {
          "$ref": "#/$defs/Text"
        },
        "spot_day": {
          "$ref": "#/$defs/Text"
        },
        "buy_price": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "buy_price_note": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_earnings": {
          "$ref": "#/$defs/Text"
        },
        "counts": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "Mark": {
      "description": "An info mark said once above the table.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label",
        "gloss"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Text"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "gloss": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "LegendItem": {
      "description": "One line of the legend; text is Chinese with the current values.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "title",
        "text"
      ],
      "properties": {
        "tier": {
          "$ref": "#/$defs/Text"
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "TierColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "hint"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Text"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "hint": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "word",
        "icon",
        "title",
        "explain",
        "collapsed",
        "rows"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "fits",
            "check",
            "grey_no_buy_price",
            "grey_no_spot",
            "grey_in_the_money",
            "grey_no_bid",
            "grey_above_buy_price",
            "grey_bad_input"
          ]
        },
        "word": {
          "$ref": "#/$defs/Text"
        },
        "icon": {
          "type": "string",
          "enum": [
            "check",
            "alert",
            "minus"
          ]
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "explain": {
          "$ref": "#/$defs/Text"
        },
        "collapsed": {
          "type": "boolean"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TierRow"
          }
        }
      }
    },
    "TierRow": {
      "description": "line is the one-line text of a grey row.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "company",
        "contract",
        "margin",
        "below_spot",
        "premium",
        "badges",
        "notes",
        "fields",
        "line"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Text"
        },
        "company": {
          "$ref": "#/$defs/Text"
        },
        "contract": {
          "$ref": "#/$defs/Contract"
        },
        "margin": {
          "$ref": "#/$defs/Pair"
        },
        "below_spot": {
          "$ref": "#/$defs/Pair"
        },
        "premium": {
          "$ref": "#/$defs/Pair"
        },
        "badges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Badge"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Badge"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          }
        },
        "line": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "strike",
        "expiry",
        "dte"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/Text"
        },
        "strike": {
          "$ref": "#/$defs/Text"
        },
        "expiry": {
          "$ref": "#/$defs/Text"
        },
        "dte": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "Pair": {
      "description": "A Pair with a gap has the gap text in main and sub null.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main",
        "sub",
        "gap"
      ],
      "properties": {
        "main": {
          "$ref": "#/$defs/Text"
        },
        "sub": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "gap": {
          "oneOf": [
            {
              "$ref": "#/$defs/Gap"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label",
        "gloss",
        "tone"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Text"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "gloss": {
          "$ref": "#/$defs/Text"
        },
        "tone": {
          "type": "string",
          "enum": [
            "warn",
            "info",
            "none"
          ]
        }
      }
    },
    "Field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "hint",
        "value",
        "gap",
        "badges"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Text"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "hint": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "gap": {
          "oneOf": [
            {
              "$ref": "#/$defs/Gap"
            },
            {
              "type": "null"
            }
          ]
        },
        "badges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Badge"
          }
        }
      }
    }
  }
}
