{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optdesk.invalid/schemas/page.option_candidates_page.v1.json",
  "title": "OptionCandidatesPage",
  "description": "The option candidates page: the stored short puts, covered calls and guard rows of the last run. A render of rows a producer writes; nothing is computed here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "stale",
    "title",
    "notes",
    "gaps",
    "chain_day",
    "computed_at",
    "rule_version",
    "estimate_note",
    "groups"
  ],
  "properties": {
    "schema": {
      "const": "option_candidates_page",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "run_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "build_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "scope": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "generated_at": {
      "$ref": "common.v2.json#/$defs/Timestamp"
    },
    "data_times": {
      "type": "array",
      "items": {
        "$ref": "common.v2.json#/$defs/SourceTime"
      }
    },
    "run_status": {
      "$ref": "common.v2.json#/$defs/RunStatus"
    },
    "stale": {
      "oneOf": [
        {
          "$ref": "common.v2.json#/$defs/StaleLabel"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "$ref": "#/$defs/Text"
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Text"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Gap"
      }
    },
    "chain_day": {
      "description": "Date text of the option chain day, or null.",
      "oneOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ]
    },
    "computed_at": {
      "description": "Time the run was computed, text in the owner zone, or null.",
      "oneOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ]
    },
    "rule_version": {
      "oneOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ]
    },
    "estimate_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "groups": {
      "description": "One to four groups in the order short_put, the yen short_put when present, covered_call, held_call_guard.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/Group"
      }
    },
    "stale_after": {
      "$ref": "common.v2.json#/$defs/Timestamp"
    },
    "short_put_list": {
      "description": "The grouped short put list, or null. Additive and optional; every figure is text.",
      "oneOf": [
        {
          "$ref": "#/$defs/ShortList"
        },
        {
          "type": "null"
        }
      ]
    },
    "short_put_tiers": {
      "description": "The tier view of the stored short puts, or null. Additive and optional; every figure is text.",
      "oneOf": [
        {
          "$ref": "#/$defs/TierView"
        },
        {
          "type": "null"
        }
      ]
    },
    "short_put_tiers_jpy": {
      "description": "The yen tier view of the stored yen short puts, or null. Built from the JP group; additive and optional; every figure is text.",
      "oneOf": [
        {
          "$ref": "#/$defs/TierView"
        },
        {
          "type": "null"
        }
      ]
    },
    "short_put_list_jpy": {
      "description": "The yen grouped short put list, or null. Built from the JP group; additive and optional; every figure is text.",
      "oneOf": [
        {
          "$ref": "#/$defs/ShortList"
        },
        {
          "type": "null"
        }
      ]
    },
    "subtitle": {
      "$ref": "#/$defs/Text"
    },
    "head_labels": {
      "description": "The words of the page head, in Chinese; additive and optional.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data_day",
            "run_status",
            "run_status_text",
            "rule_version"
          ],
          "properties": {
            "data_day": {
              "$ref": "#/$defs/Text"
            },
            "run_status": {
              "$ref": "#/$defs/Text"
            },
            "run_status_text": {
              "$ref": "#/$defs/Text"
            },
            "rule_version": {
              "$ref": "#/$defs/Text"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "ShortList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_day",
        "counts",
        "caveat",
        "filters",
        "dropped",
        "dropped_items",
        "columns",
        "groups",
        "folded_title"
      ],
      "properties": {
        "run_day": {
          "$ref": "#/$defs/Text"
        },
        "counts": {
          "$ref": "#/$defs/Text"
        },
        "caveat": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Filter"
          }
        },
        "dropped": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "dropped_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DroppedItem"
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TierColumn"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShortGroup"
          }
        },
        "folded_title": {
          "$ref": "#/$defs/Text"
        }
      },
      "description": "The grouped short put list, or null. Additive and optional; every figure is text."
    },
    "Filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value",
        "hint"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Text"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "value": {
          "$ref": "#/$defs/Text"
        },
        "hint": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "DroppedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label",
        "count",
        "hint"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Text"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "count": {
          "$ref": "#/$defs/Text"
        },
        "hint": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "ShortGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "spot",
        "summary",
        "rows"
      ],
      "properties": {
        "ticker": {
          "$ref": "#/$defs/Text"
        },
        "spot": {
          "$ref": "#/$defs/Text"
        },
        "summary": {
          "$ref": "#/$defs/Text"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShortRow"
          }
        }
      }
    },
    "ShortRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "strike",
        "expiry",
        "otm",
        "delta",
        "premium",
        "annualized",
        "buy",
        "buy_source",
        "buy_link",
        "badges"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/Text"
        },
        "strike": {
          "$ref": "#/$defs/Pair"
        },
        "expiry": {
          "$ref": "#/$defs/Pair"
        },
        "otm": {
          "$ref": "#/$defs/Pair"
        },
        "delta": {
          "$ref": "#/$defs/Pair"
        },
        "premium": {
          "$ref": "#/$defs/Pair"
        },
        "annualized": {
          "$ref": "#/$defs/Pair"
        },
        "buy": {
          "$ref": "#/$defs/Pair"
        },
        "buy_source": {
          "oneOf": [
            {
              "$ref": "#/$defs/Badge"
            },
            {
              "type": "null"
            }
          ]
        },
        "buy_link": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "badges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Badge"
          }
        }
      }
    },
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "Group": {
      "description": "One kind of candidate. gap is non-null exactly when main and other are both null.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "day",
        "stale",
        "counts",
        "main",
        "other",
        "gap"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "short_put",
            "covered_call",
            "held_call_guard"
          ]
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "day": {
          "description": "Date text of the rows of this group, or null.",
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "description": "True when day is before the build day.",
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/$defs/Counts"
        },
        "main": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Table"
            }
          ]
        },
        "other": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Table"
            }
          ]
        },
        "gap": {
          "oneOf": [
            {
              "$ref": "#/$defs/Gap"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "description": "Currency of the rows of this group as three upper-case letters (JPY for the Japanese group); null or absent for the US groups. Additive and optional.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "description": "One-line note of the group, or null. Additive and optional.",
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit_counts": {
          "description": "Counts of the rows by limit, or null. Additive and optional.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "count",
                  "text"
                ],
                "properties": {
                  "limit": {
                    "$ref": "#/$defs/Text"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "text": {
                    "$ref": "#/$defs/Text"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "main": {
                  "type": "null"
                },
                "other": {
                  "type": "null"
                },
                "gap": {
                  "$ref": "#/$defs/Gap"
                }
              }
            },
            {
              "properties": {
                "gap": {
                  "type": "null"
                }
              },
              "anyOf": [
                {
                  "properties": {
                    "main": {
                      "$ref": "#/$defs/Table"
                    }
                  }
                },
                {
                  "properties": {
                    "other": {
                      "$ref": "#/$defs/Table"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "Counts": {
      "description": "The stored row counts of the group.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "blocked",
        "unknown"
      ],
      "properties": {
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "rows"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Row"
          }
        }
      }
    },
    "Column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "align",
        "hint"
      ],
      "properties": {
        "id": {
          "$ref": "common.v2.json#/$defs/Id"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "hint": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cells",
        "reasons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cand-[A-Za-z0-9_-]{1,64}$"
        },
        "cells": {
          "description": "Column id to Cell.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Cell"
          }
        },
        "reasons": {
          "description": "Only on other rows; empty on main rows.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reason"
          }
        }
      }
    },
    "Cell": {
      "oneOf": [
        {
          "$ref": "#/$defs/ValueCell"
        },
        {
          "$ref": "#/$defs/Gap"
        }
      ]
    },
    "ValueCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "value",
        "badges",
        "tone"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 200
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "badges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          }
        },
        "tone": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "flat",
            "none"
          ]
        }
      }
    },
    "Reason": {
      "description": "Why a row is blocked or unknown. gate and code are patterns, not enums, so a new gate needs no schema change.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "status",
        "code",
        "text"
      ],
      "properties": {
        "gate": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "block",
            "unknown"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z_]{1,48}$"
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "Gap": {
      "description": "A named data gap, used in place of a value that cannot be shown. Never a zero. The reasons of common.v2 plus no_rows (a group without rows in its lookback), no_run (no stored run) and unreadable (a stored value that cannot be shown).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "gap",
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "missing_quote",
            "no_data",
            "unsupported_currency",
            "not_built",
            "no_reader",
            "no_news_source",
            "no_rule",
            "market_closed",
            "stale",
            "flex_time_unknown",
            "jp_slice_missing",
            "missing_input",
            "stale_input",
            "no_rows",
            "no_run",
            "unreadable"
          ]
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "TierView": {
      "description": "The short puts sorted into tiers, from docs/design/candidates-tiers.md#Interface.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_day",
        "companies",
        "common",
        "kept",
        "legend",
        "columns",
        "tiers"
      ],
      "properties": {
        "chain_day": {
          "$ref": "#/$defs/Text"
        },
        "companies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Company"
          }
        },
        "common": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mark"
          }
        },
        "kept": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "kept_note": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_title": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "idle_note": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "buy_hint": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "spot_hint": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "legend": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LegendItem"
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TierColumn"
          }
        },
        "tiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tier"
          }
        },
        "strip_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spot",
            "buy_price",
            "next_earnings",
            "contracts",
            "fits",
            "check",
            "grey",
            "grey_hint"
          ],
          "properties": {
            "spot": {
              "$ref": "#/$defs/Text"
            },
            "buy_price": {
              "$ref": "#/$defs/Text"
            },
            "next_earnings": {
              "$ref": "#/$defs/Text"
            },
            "contracts": {
              "$ref": "#/$defs/Text"
            },
            "fits": {
              "$ref": "#/$defs/Text"
            },
            "check": {
              "$ref": "#/$defs/Text"
            },
            "grey": {
              "$ref": "#/$defs/Text"
            },
            "grey_hint": {
              "$ref": "#/$defs/Text"
            }
          }
        },
        "card_note": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "heads": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "companies",
            "companies_note",
            "tiers"
          ],
          "properties": {
            "companies": {
              "$ref": "#/$defs/Text"
            },
            "companies_note": {
              "$ref": "#/$defs/Text"
            },
            "tiers": {
              "$ref": "#/$defs/Text"
            }
          }
        },
        "by_company": {
          "$ref": "#/$defs/ByCompany"
        }
      }
    },
    "Company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "ticker",
        "spot",
        "spot_day",
        "buy_price",
        "buy_price_note",
        "next_earnings",
        "counts"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/Text"
        },
        "ticker": {
          "$ref": "#/$defs/Text"
        },
        "spot": {
          "$ref": "#/$defs/Text"
        },
        "spot_day": {
          "$ref": "#/$defs/Text"
        },
        "buy_price": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "buy_price_note": {
          "oneOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_earnings": {
          "$ref": "#/$defs/Text"
        },
        "counts": {
          "$ref": "#/$defs/Text"
        },
