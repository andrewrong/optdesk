      "type": "object"
    },
    "SourceTime": {
      "additionalProperties": false,
      "description": "The data time of one source behind the card.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "source": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "data_time"
      ],
      "title": "SourceTime",
      "type": "object"
    },
    "StaleLabel": {
      "additionalProperties": false,
      "description": "Python sends the times and the label; the browser only compares its clock with ``stale_after``.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "stale_after": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Stale After",
          "type": "string",
          "x-timezone": "owner"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "data_time",
        "stale_after",
        "text"
      ],
      "title": "StaleLabel",
      "type": "object"
    },
