{
  "$defs": {
    "Cell": {
      "additionalProperties": false,
      "description": "One displayed table cell.",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "enum": [
            "up",
            "down",
            "flat",
            "none"
          ],
          "title": "Tone",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "USD",
                "amount_signed",
                "percent",
                "share_percent",
                "index_points",
                "percent_of_track",
                "vol_points",
                "percentage_points"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1000000000000.0,
              "minimum": -1000000000000.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "text",
        "tone"
      ],
      "title": "Cell",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Align",
          "type": "string"
        },
        "id": {
          "enum": [
            "code",
            "name",
            "role",
            "quantity",
            "cost",
            "price",
            "day",
            "unrealised"
          ],
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "align"
      ],
      "title": "Column",
      "type": "object"
    },
    "DaysCell": {
      "additionalProperties": false,
      "description": "Calendar days from the market's today to the expiry; negative once expired (issue #1448).",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "const": "days",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 100000,
          "minimum": -100000,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "DaysCell",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "description": "A named data gap, used in place of a figure that cannot be computed. Never a zero.",
      "properties": {
        "reason": {
          "enum": [
            "missing_quote",
            "no_data",
            "unsupported_currency",
            "not_built",
            "no_reader",
            "no_news_source",
            "no_rule",
            "market_closed",
            "stale",
            "flex_time_unknown",
            "jp_slice_missing",
            "missing_input",
            "stale_input"
          ],
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "text"
      ],
      "title": "Gap",
      "type": "object"
    },
    "MoneyCell": {
      "additionalProperties": false,
      "description": "A money cell with a currency and, for JPY, an optional display-only ``approx_usd``.",
      "properties": {
        "approx_usd": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsdFigure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "currency": {
          "enum": [
            "USD",
            "JPY"
          ],
          "title": "Currency",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "anyOf": [
            {
              "enum": [
                "up",
                "down",
                "flat",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tone"
        },
        "unit": {
          "enum": [
            "amount",
            "amount_per_share",
            "amount_signed"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000,
          "minimum": -1000000000,
          "multipleOf": 0.01,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "text",
        "unit",
        "currency"
      ],
      "title": "MoneyCell",
      "type": "object"
    },
    "OptionColumn": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Align",
          "type": "string"
        },
        "id": {
          "enum": [
            "code",
            "name",
            "expiry",
