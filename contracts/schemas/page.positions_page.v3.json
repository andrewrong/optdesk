              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Day"
        },
        "days_left": {
          "anyOf": [
            {
              "$ref": "#/$defs/DaysCell"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Days Left"
        },
        "expiry": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextCell"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Expiry"
        },
        "name": {
          "$ref": "#/$defs/TextCell"
        },
        "open_premium": {
          "anyOf": [
            {
              "$ref": "#/$defs/PremiumCell"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Open Premium"
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyCell"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Price"
        },
        "quantity": {
          "$ref": "#/$defs/OptionQuantityCell"
        },
        "role": {
          "$ref": "#/$defs/RoleCell"
        },
        "unrealised": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyCell"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Unrealised"
        }
      },
      "required": [
        "code",
        "name",
        "expiry",
        "days_left",
        "role",
        "quantity",
        "cost",
        "price",
        "day",
        "unrealised",
        "open_premium"
      ],
      "title": "OptionRow",
      "type": "object"
    },
    "OptionsTable": {
