    "UsdFigure": {
      "additionalProperties": false,
      "description": "A displayed US-dollar amount (two decimals in ``value``, whole dollars in ``text``).",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
