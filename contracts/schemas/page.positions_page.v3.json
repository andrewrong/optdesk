            "role",
            "quantity",
            "cost",
            "price",
            "day",
            "unrealised",
            "open_premium"
          ],
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
