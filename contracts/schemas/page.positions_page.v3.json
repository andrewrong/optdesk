    "OptionRow": {
      "additionalProperties": false,
      "description": "A ``PositionRow`` with the expiry (ISO date) and the days left after the name.",
      "properties": {
        "code": {
          "$ref": "#/$defs/TextCell"
        },
        "cost": {
          "$ref": "#/$defs/MoneyCell"
        },
        "day": {
          "anyOf": [
