{
  "$defs": {
    "Card": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Columns",
          "type": "array"
        },
        "data_times_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Data Times Text",
          "type": "string"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/Gap"
          },
          "maxItems": 20,
          "title": "Gaps",
          "type": "array"
        },
        "notes": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Notes",
          "type": "array"
        },
        "rows": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Row"
              },
              "maxItems": 30,
              "type": "array"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Rows"
        },
        "say": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Say",
          "type": "string"
        },
        "stale": {
          "$ref": "#/$defs/StaleLabel"
        },
        "subtitle": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Subtitle",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "say",
        "subtitle",
        "stale",
        "columns",
        "rows",
        "notes",
        "gaps",
        "data_times_text"
      ],
      "title": "Card",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "company",
            "earnings",
            "day_change",
            "five_day_change"
          ],
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Column",
      "type": "object"
    },
    "EarningsCell": {
      "additionalProperties": false,
      "description": "A results date: ``date`` is the ISO day, ``text`` what is shown (``10-28`` or ``已公布 10-20``).",
      "properties": {
        "date": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
          "title": "Date",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "date",
        "text"
      ],
      "title": "EarningsCell",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "description": "A named data gap, used in place of a figure that cannot be computed. Never a zero.",
      "properties": {
        "reason": {
          "enum": [
            "missing_quote",
            "no_data",
            "unsupported_currency",
            "not_built",
            "no_reader",
            "no_news_source",
            "no_rule",
            "market_closed",
            "stale",
            "flex_time_unknown",
            "jp_slice_missing",
            "missing_input",
            "stale_input"
          ],
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "text"
      ],
      "title": "Gap",
      "type": "object"
    },
    "PercentFigure": {
      "additionalProperties": false,
      "description": "A fraction times 100, signed (``+2.1%``).",
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "anyOf": [
            {
              "enum": [
                "up",
                "down",
                "flat",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tone"
        },
        "unit": {
          "const": "percent",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "Value",
          "type": "number",
          "x-decimals": 4,
          "x-rounding": "ROUND_HALF_UP"
        }
      },
      "required": [
        "value",
        "text",
        "unit"
      ],
      "title": "PercentFigure",
      "type": "object"
    },
    "Row": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "enum": [
            "USD",
            "JPY"
          ],
          "title": "Currency",
          "type": "string"
        },
        "day_change": {
          "anyOf": [
            {
              "$ref": "#/$defs/PercentFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Day Change"
        },
        "earnings": {
          "anyOf": [
            {
              "$ref": "#/$defs/EarningsCell"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Earnings"
        },
        "five_day_change": {
          "anyOf": [
            {
              "$ref": "#/$defs/PercentFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Five Day Change"
        },
        "symbol": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "volatility": {
          "$ref": "#/$defs/VolatilityLine"
        }
      },
      "required": [
        "symbol",
        "currency",
        "earnings",
        "day_change",
        "five_day_change",
        "volatility"
      ],
      "title": "Row",
      "type": "object"
    },
    "SourceTime": {
      "additionalProperties": false,
      "description": "The data time of one source behind the card.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "source": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "data_time"
      ],
      "title": "SourceTime",
      "type": "object"
    },
    "StaleLabel": {
      "additionalProperties": false,
      "description": "Python sends the times and the label; the browser only compares its clock with ``stale_after``.",
      "properties": {
        "data_time": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Data Time",
          "type": "string",
          "x-timezone": "owner"
        },
        "stale_after": {
          "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
          "title": "Stale After",
          "type": "string",
          "x-timezone": "owner"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "data_time",
        "stale_after",
        "text"
      ],
      "title": "StaleLabel",
      "type": "object"
    },
    "VolatilityLine": {
      "additionalProperties": false,
      "description": "The tool's own HV30, IV30 and IV percentile of a name (ADR 0033 change 9). ``source`` is the short\nlabel (\"own\"), ``label`` names the conventions and the data day; the figures are percents without a\nsign or tone, a part that is not an ``ok`` reading of the day is a ``Gap``, and one of an earlier day\ncarries that day in its ``text``. ``reconciliation`` is the status the readings carry against IBKR's\nseries; no IBKR value is shown.",
      "properties": {
        "data_day": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
          "title": "Data Day",
          "type": "string"
        },
        "hv30": {
          "anyOf": [
            {
              "$ref": "#/$defs/PercentFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Hv30"
        },
        "iv30": {
          "anyOf": [
            {
              "$ref": "#/$defs/PercentFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Iv30"
        },
        "ivp": {
          "anyOf": [
            {
              "$ref": "#/$defs/PercentFigure"
            },
            {
              "$ref": "#/$defs/Gap"
            }
          ],
          "title": "Ivp"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "reconciliation": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reconciliation",
          "type": "string"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "label",
        "data_day",
        "hv30",
        "iv30",
        "ivp",
        "reconciliation"
      ],
      "title": "VolatilityLine",
      "type": "object"
    }
  },
  "$id": "https://option-trader.invalid/schemas/held_companies_summary.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Envelope (ADR 0034) and card. No envelope currency: the names carry their own.",
  "properties": {
    "build_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Build Id",
      "type": "string"
    },
    "card": {
      "$ref": "#/$defs/Card"
    },
    "data_times": {
      "items": {
        "$ref": "#/$defs/SourceTime"
      },
      "maxItems": 20,
      "title": "Data Times",
      "type": "array"
    },
    "generated_at": {
      "pattern": "^(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\+08:00$",
      "title": "Generated At",
      "type": "string",
      "x-timezone": "owner"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "schema": {
      "const": "held_companies_summary",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "data_times",
    "run_status",
    "card"
  ],
  "title": "HeldCompaniesSummary",
  "type": "object"
}
