{
  "$defs": {
    "BlockLink": {
      "additionalProperties": false,
      "description": "A link the home page shows: the path it goes to and its words.",
      "properties": {
        "href": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^/",
          "title": "Href",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "href",
        "text"
      ],
      "title": "BlockLink",
      "type": "object"
    },
    "GapItem": {
      "additionalProperties": false,
      "description": "A real gap of a card, by the card's title.",
      "properties": {
        "card": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Card",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "card",
        "text"
      ],
      "title": "GapItem",
      "type": "object"
    },
    "Overview": {
      "additionalProperties": false,
      "description": "The top card: one line per card and the real gaps.",
      "properties": {
        "gaps": {
          "items": {
            "$ref": "#/$defs/GapItem"
          },
          "maxItems": 20,
          "title": "Gaps",
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/OverviewLine"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items",
        "gaps"
      ],
      "title": "Overview",
      "type": "object"
    },
    "OverviewLine": {
      "additionalProperties": false,
      "description": "A card summary line: ``label`` links to ``href``, ``text`` is the card's own words.",
      "properties": {
        "href": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Href",
          "type": "string",
          "pattern": "^/"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "label",
        "text",
        "href"
      ],
      "title": "OverviewLine",
      "type": "object"
    }
  },
  "$id": "https://optdesk.invalid/schemas/page.home_page.v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Envelope (ADR 0034), the home texts and links, and the five summary pages as members.",
  "properties": {
    "schema": {
      "const": "home_page",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "run_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "build_id": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "scope": {
      "$ref": "common.v2.json#/$defs/Id"
    },
    "generated_at": {
      "$ref": "common.v2.json#/$defs/Timestamp"
    },
    "data_times": {
      "items": {
        "$ref": "common.v2.json#/$defs/SourceTime"
      },
      "maxItems": 20,
      "title": "Data Times",
      "type": "array"
    },
    "run_status": {
      "$ref": "common.v2.json#/$defs/RunStatus"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "say": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Say",
      "type": "string"
    },
    "gap_line": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Gap Line",
      "type": "string"
    },
    "overview": {
      "$ref": "#/$defs/Overview"
    },
    "report_links": {
      "items": {
        "$ref": "#/$defs/BlockLink"
      },
      "maxItems": 10,
      "title": "Report Links",
      "type": "array"
    },
    "household": {
      "$ref": "page.household_summary.v2.json"
    },
    "companies": {
      "$ref": "page.held_companies_summary.v3.json"
    },
    "macro": {
      "$ref": "page.macro_summary.v2.json"
    },
    "market": {
      "$ref": "page.market_summary.v3.json"
    },
    "options": {
      "$ref": "page.options_summary.v4.json"
    },
    "stale_after": {
      "$ref": "common.v2.json#/$defs/Timestamp"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "build_id",
    "scope",
    "generated_at",
    "stale_after",
    "data_times",
    "run_status",
    "title",
    "say",
    "gap_line",
    "overview",
    "report_links",
    "household",
    "companies",
    "macro",
    "market",
    "options"
  ],
  "title": "HomePage",
  "type": "object"
}
